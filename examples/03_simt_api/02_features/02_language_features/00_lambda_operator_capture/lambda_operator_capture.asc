/* !
 * \file lambda_operator_capture.asc
 * \brief 以LeakyReLU-Affine融合算子与Clamp算子为载体，展示SIMT编程核函数内Lambda捕获外部参数的
 *        实际编程作用：
 *        1. 值捕获携带算子超参：alpha/scale/bias/lo/hi经核函数参数传入，由核内Lambda值捕获，
 *           框架函数签名不感知任何算子参数；
 *        2. 引用捕获累计统计状态：每线程负数计数被统计Lambda原地更新，不经过参数传递；
 *        3. 闭包组合：外层Lambda引用捕获内层闭包，一次遍历完成"统计-激活-仿射"；
 *        4. 策略与框架分离：通用elementwise_transform注入不同Lambda即得到不同算子，
 *           线程映射代码只写一份。
 */

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"

namespace {
constexpr uint32_t THREADS_PER_BLOCK = 256U;
constexpr uint32_t BLOCKS_PER_GRID = 4U;
constexpr uint32_t TOTAL_THREADS = BLOCKS_PER_GRID * THREADS_PER_BLOCK;
constexpr uint32_t TOTAL_LENGTH = 4096U;

// 算子超参：LeakyReLU负区斜率、仿射变换系数、Clamp上下界
constexpr float ALPHA = 0.1f;
constexpr float SCALE = 2.0f;
constexpr float BIAS = 1.0f;
constexpr float CLAMP_LO = -2.0f;
constexpr float CLAMP_HI = 3.0f;

// Host侧以同一公式生成输入（取值[-5, 5]，覆盖正数/负数/越界裁剪点），保证期望值可精确复算
inline float make_input(uint32_t i) { return static_cast<float>((i * 7U) % 11U) - 5.0f; }
} // namespace

/*
 * 通用逐元素变换框架（Device侧）：只负责线程映射与网格跨度循环，不感知任何算子语义。
 * 具体算子由调用方以Lambda注入，一份线程映射代码可服务任意逐元素算子。
 */
template <typename Op>
__aicore__ inline void elementwise_transform(Op op, const float* input, float* output, uint32_t total_length)
{
    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t stride = gridDim.x * blockDim.x;
    for (; idx < total_length; idx += stride) {
        output[idx] = op(input[idx]);
    }
}

/*
 * 融合算子核函数（一次启动完成两个算子）：
 *   y1[i] = scale * leaky_relu(x[i], alpha) + bias，同遍历统计每线程处理的负数个数；
 *   y2[i] = clamp(x[i], lo, hi)。
 * 算子超参全部经核函数参数传入（Host无法把Lambda闭包传入核函数），在核函数内定义Lambda捕获消费。
 */
__global__ __launch_bounds__(THREADS_PER_BLOCK) void lambda_operator_kernel(
    const float* input, float* yLeakyAffine, float* yClamp, uint32_t* negStats, uint32_t totalLength, float alpha,
    float scale, float bias, float lo, float hi)
{
    // ---- 算子1：LeakyReLU-Affine融合 + 负数统计 ----
    // 值捕获：超参拷贝进闭包，elementwise_transform无需为算子参数增加形参
    auto leaky = [alpha](float v) { return v > 0.0f ? v : alpha * v; };
    auto affine = [scale, bias](float v) { return v * scale + bias; };
    // 引用捕获：统计状态由闭包原地累计，无需经由参数或返回值传递
    uint32_t negCount = 0;
    auto tally = [&negCount](float v) {
        if (v < 0.0f) {
            ++negCount;
        }
    };
    // 闭包组合：外层Lambda引用捕获三个内层闭包，一次遍历完成"统计-激活-仿射"
    auto fused = [&tally, &leaky, &affine](float v) {
        tally(v);
        return affine(leaky(v));
    };
    elementwise_transform(fused, input, yLeakyAffine, totalLength);
    negStats[blockIdx.x * blockDim.x + threadIdx.x] = negCount;

    // ---- 算子2：Clamp，同一框架函数注入不同Lambda即得到另一个算子 ----
    auto clamp = [lo, hi](float v) { return v < lo ? lo : (v > hi ? hi : v); };
    elementwise_transform(clamp, input, yClamp, totalLength);
}

namespace {

// Host侧复算期望值：与核内Lambda完全相同的公式、相同的线程映射
bool verify_result(
    const std::vector<float>& input, const std::vector<float>& yLeakyAffine, const std::vector<float>& yClamp,
    const std::vector<uint32_t>& negStats, uint32_t& negTotal)
{
    constexpr float tolerance = 1e-5f;
    bool ok = true;
    uint32_t printed = 0;

    for (uint32_t i = 0; i < TOTAL_LENGTH; ++i) {
        const float x = input[i];
        const float expectLeakyAffine = (x > 0.0f ? x : ALPHA * x) * SCALE + BIAS;
        const float expectClamp = x < CLAMP_LO ? CLAMP_LO : (x > CLAMP_HI ? CLAMP_HI : x);
        if (std::fabs(yLeakyAffine[i] - expectLeakyAffine) >
            tolerance * std::fmax(1.0f, std::fabs(expectLeakyAffine))) {
            ok = false;
            if (printed < 8) {
                std::printf("leaky-affine mismatch @%u: %f expect %f\n", i, yLeakyAffine[i], expectLeakyAffine);
                ++printed;
            }
        }
        if (std::fabs(yClamp[i] - expectClamp) > tolerance * std::fmax(1.0f, std::fabs(expectClamp))) {
            ok = false;
            if (printed < 8) {
                std::printf("clamp mismatch @%u: %f expect %f\n", i, yClamp[i], expectClamp);
                ++printed;
            }
        }
    }

    // 每线程负数计数期望值：按与elementwise_transform相同的线程映射复算
    negTotal = 0;
    for (uint32_t t = 0; t < TOTAL_THREADS; ++t) {
        uint32_t expectCount = 0;
        for (uint32_t i = t; i < TOTAL_LENGTH; i += TOTAL_THREADS) {
            if (input[i] < 0.0f) {
                ++expectCount;
            }
        }
        negTotal += negStats[t];
        if (negStats[t] != expectCount) {
            ok = false;
            if (printed < 8) {
                std::printf("neg-stats mismatch @thread %u: %u expect %u\n", t, negStats[t], expectCount);
                ++printed;
            }
        }
    }
    return ok;
}

} // namespace

int32_t main()
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const size_t tensorBytes = TOTAL_LENGTH * sizeof(float);
    const size_t statsBytes = TOTAL_THREADS * sizeof(uint32_t);

    std::vector<float> hostInput(TOTAL_LENGTH);
    for (uint32_t i = 0; i < TOTAL_LENGTH; ++i) {
        hostInput[i] = make_input(i);
    }
    std::vector<float> hostLeakyAffine(TOTAL_LENGTH, 0.0f);
    std::vector<float> hostClamp(TOTAL_LENGTH, 0.0f);
    std::vector<uint32_t> hostNegStats(TOTAL_THREADS, 0U);

    float* devInput = nullptr;
    float* devLeakyAffine = nullptr;
    float* devClamp = nullptr;
    uint32_t* devNegStats = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&devInput), tensorBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&devLeakyAffine), tensorBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&devClamp), tensorBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&devNegStats), statsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(devInput, tensorBytes, hostInput.data(), tensorBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    lambda_operator_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, 0, stream>>>(
        devInput, devLeakyAffine, devClamp, devNegStats, TOTAL_LENGTH, ALPHA, SCALE, BIAS, CLAMP_LO, CLAMP_HI);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(hostLeakyAffine.data(), tensorBytes, devLeakyAffine, tensorBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(hostClamp.data(), tensorBytes, devClamp, tensorBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(hostNegStats.data(), statsBytes, devNegStats, statsBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    uint32_t negTotal = 0;
    const bool ok = verify_result(hostInput, hostLeakyAffine, hostClamp, hostNegStats, negTotal);
    std::printf(
        "[lambda_operator_capture] leaky-affine + clamp via capturing lambdas: %s "
        "(y[5]=%f, yClamp[5]=%f, negTotal=%u)\n",
        ok ? "PASS" : "FAIL", hostLeakyAffine[5], hostClamp[5], negTotal);

    aclrtFree(devInput);
    aclrtFree(devLeakyAffine);
    aclrtFree(devClamp);
    aclrtFree(devNegStats);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return ok ? 0 : 1;
}
