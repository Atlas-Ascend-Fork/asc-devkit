#ifndef SCENARIO_NUM
#define SCENARIO_NUM 3
#endif
#if SCENARIO_NUM < 0 || SCENARIO_NUM > 3
#error "SCENARIO_NUM must be one of 0, 1, 2, 3."
#endif

#ifndef LOAD_FACTOR
#define LOAD_FACTOR 0.9
#endif

#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <random>
#include <unordered_map>
#include <unordered_set>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

namespace {

constexpr uint64_t EMPTY_KEY = 0xFFFFFFFFFFFFFFFFULL;
constexpr uint32_t NOT_FOUND = 0xFFFFFFFFu;
constexpr uint32_t CAPACITY = 1u << 20;
constexpr uint32_t DIM = 8;
constexpr uint32_t STRIDE = 4;
constexpr uint32_t THREADS_PER_BLOCK = 512;
constexpr uint32_t AIV_CORE_NUM = 64;
constexpr double kLoadFactor = LOAD_FACTOR;
constexpr double HIT_RATIO = 0.8;
constexpr uint32_t QUERY_NUM = 1u << 20;

} // namespace

struct AoSBucket {
    uint64_t key;
    float value[DIM];
};

struct SoaTable {
    uint64_t key[CAPACITY];
    float value[CAPACITY][DIM];
};

struct SoaTableWithDigest {
    uint8_t digest[CAPACITY];
    uint64_t key[CAPACITY];
    float value[CAPACITY][DIM];
};

__host__ __aicore__ inline uint64_t murmur3_hash(uint64_t key)
{
    key ^= key >> 33;
    key *= 0xff51afd7ed558ccdULL;
    key ^= key >> 33;
    key *= 0xc4ceb9fe1a85ec53ULL;
    key ^= key >> 33;
    return key;
}

__host__ __aicore__ inline uint8_t digest_of(uint64_t hashed) { return static_cast<uint8_t>(hashed >> 32); }

__host__ __aicore__ inline uint32_t digest_word_of(uint64_t hashed)
{
    return static_cast<uint32_t>(digest_of(hashed)) * 0x01010101u;
}

__aicore__ inline uint32_t vcmp_eq4(uint32_t a, uint32_t b)
{
    const uint32_t x = a ^ b;
    const uint32_t d = (x & 0x7F7F7F7Fu) + 0x7F7F7F7Fu;
    return ((~(d | x)) & 0x80808080u) >> 7;
}

__aicore__ inline uint32_t find_aos(const AoSBucket* table, uint64_t target_key, uint32_t start)
{
    uint32_t idx = start;
    for (uint32_t i = 0; i < CAPACITY; ++i) {
        const uint64_t bucket_key = table[idx].key;
        if (bucket_key == target_key) {
            return idx;
        }
        if (bucket_key == EMPTY_KEY) {
            return NOT_FOUND;
        }
        idx = (idx + 1) & (CAPACITY - 1);
    }
    return NOT_FOUND;
}

__aicore__ inline uint32_t find_soa(const SoaTable* table, uint64_t target_key, uint32_t start)
{
    uint32_t idx = start;
    for (uint32_t i = 0; i < CAPACITY; ++i) {
        const uint64_t bucket_key = table->key[idx];
        if (bucket_key == target_key) {
            return idx;
        }
        if (bucket_key == EMPTY_KEY) {
            return NOT_FOUND;
        }
        idx = (idx + 1) & (CAPACITY - 1);
    }
    return NOT_FOUND;
}

__aicore__ inline uint32_t find_soa_digest_vcmp(
    const SoaTableWithDigest* table, uint64_t target_key, uint32_t start, uint32_t target_word)
{
    const uint32_t empty_word = digest_word_of(murmur3_hash(EMPTY_KEY));
    const uint32_t first_pos = start & (CAPACITY - STRIDE);
    for (uint32_t offset = 0; offset < CAPACITY + STRIDE; offset += STRIDE) {
        const uint32_t pos = (first_pos + offset) & (CAPACITY - 1);

        const uint32_t probe = *reinterpret_cast<const uint32_t*>(table->digest + pos);
        uint32_t cmp = vcmp_eq4(probe, target_word) & 0x01010101u;
        while (cmp != 0) {
            const uint32_t idx = pos + (((static_cast<uint32_t>(__ffs(static_cast<int32_t>(cmp)))) - 1u) >> 3);
            cmp &= cmp - 1;
            if (table->key[idx] == target_key) {
                return idx;
            }
        }

        cmp = vcmp_eq4(probe, empty_word) & 0x01010101u;
        while (cmp != 0) {
            const uint32_t idx = pos + (((static_cast<uint32_t>(__ffs(static_cast<int32_t>(cmp)))) - 1u) >> 3);
            cmp &= cmp - 1;
            if (offset == 0 && idx < start) {
                continue;
            }
            if (table->key[idx] == EMPTY_KEY) {
                return NOT_FOUND;
            }
        }
    }
    return NOT_FOUND;
}

std::vector<uint64_t> generate_unique_keys(size_t num)
{
    std::mt19937_64 eng(12345);
    std::uniform_int_distribution<uint64_t> distr(0, (1ULL << 62) - 1);
    std::unordered_set<uint64_t> uniq;
    uniq.reserve(num);
    while (uniq.size() < num) {
        uniq.insert(distr(eng));
    }
    return std::vector<uint64_t>(uniq.begin(), uniq.end());
}

void build_bucket_keys(const std::vector<uint64_t>& fill_keys, std::vector<uint64_t>& bucket_keys)
{
    bucket_keys.assign(CAPACITY, EMPTY_KEY);
    for (uint64_t key : fill_keys) {
        const uint64_t hashed = murmur3_hash(key);
        uint32_t idx = static_cast<uint32_t>(hashed & (CAPACITY - 1));
        while (bucket_keys[idx] != EMPTY_KEY) {
            idx = (idx + 1) & (CAPACITY - 1);
        }
        bucket_keys[idx] = key;
    }
}

std::unordered_map<uint64_t, uint32_t> build_bucket_index(const std::vector<uint64_t>& bucket_keys)
{
    std::unordered_map<uint64_t, uint32_t> index;
    index.reserve(bucket_keys.size() * 2);
    for (uint32_t i = 0; i < CAPACITY; ++i) {
        if (bucket_keys[i] != EMPTY_KEY) {
            index.emplace(bucket_keys[i], i);
        }
    }
    return index;
}

uint32_t query_aiv_core_num(int32_t device_id)
{
    int64_t core_num = 0;
    const aclError ret = aclrtGetDeviceInfo(static_cast<uint32_t>(device_id), ACL_DEV_ATTR_VECTOR_CORE_NUM, &core_num);
    return (ret == ACL_SUCCESS && core_num > 0) ? static_cast<uint32_t>(core_num) : AIV_CORE_NUM;
}

void prepare_query_data(
    std::vector<uint64_t>& query_keys, std::vector<uint32_t>& expected, std::vector<uint64_t>& bucket_keys,
    size_t& expected_hits)
{
    const size_t n_fill = static_cast<size_t>(CAPACITY * kLoadFactor);
    const size_t n_miss_q = static_cast<size_t>(QUERY_NUM * (1.0 - HIT_RATIO));
    const size_t n_hit = QUERY_NUM - n_miss_q;
    expected_hits = n_hit;

    std::vector<uint64_t> all_keys = generate_unique_keys(n_fill + n_miss_q);
    std::vector<uint64_t> fill_keys(all_keys.begin(), all_keys.begin() + n_fill);
    std::vector<uint64_t> miss_pool(all_keys.begin() + n_fill, all_keys.end());

    build_bucket_keys(fill_keys, bucket_keys);
    const std::unordered_map<uint64_t, uint32_t> bucket_index = build_bucket_index(bucket_keys);

    std::mt19937_64 qeng(54321);
    std::uniform_int_distribution<size_t> fill_distr(0, n_fill - 1);
    std::uniform_int_distribution<size_t> miss_distr(0, n_miss_q - 1);
    std::vector<std::pair<uint64_t, bool>> queries;
    queries.reserve(QUERY_NUM);
    for (size_t i = 0; i < n_hit; ++i) {
        queries.emplace_back(fill_keys[fill_distr(qeng)], true);
    }
    for (size_t i = 0; i < n_miss_q; ++i) {
        queries.emplace_back(miss_pool[miss_distr(qeng)], false);
    }
    std::shuffle(queries.begin(), queries.end(), qeng);
    query_keys.reserve(QUERY_NUM);
    expected.reserve(QUERY_NUM);
    for (const auto& q : queries) {
        query_keys.push_back(q.first);
        expected.push_back(q.second ? bucket_index.at(q.first) : NOT_FOUND);
    }
}

uint32_t verify_result(size_t mismatches, size_t actual_hits, size_t expected_hits)
{
    if (mismatches != 0 || actual_hits != expected_hits) {
        printf("[Failed] Case accuracy verification failed!\n");
        return 1;
    }
    printf("[Success] Case accuracy verification passed.\n");
    return 0;
}

#if SCENARIO_NUM == 0

__global__ __launch_bounds__(THREADS_PER_BLOCK) void lookup_aos_kernel(
    const AoSBucket* table, const uint64_t* keys, uint32_t* indices, uint32_t query_num)
{
    const uint32_t stride = gridDim.x * blockDim.x;
    for (uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x; idx < query_num; idx += stride) {
        uint32_t result = NOT_FOUND;
        const uint64_t key = keys[idx];
        if (key != EMPTY_KEY) {
            const uint64_t hashed = murmur3_hash(key);
            const uint32_t start = static_cast<uint32_t>(hashed & (CAPACITY - 1));
            result = find_aos(table, key, start);
        }
        indices[idx] = result;
    }
}

std::vector<uint8_t> build_case_table(const std::vector<uint64_t>& bucket_keys)
{
    constexpr size_t table_bytes = static_cast<size_t>(CAPACITY) * sizeof(AoSBucket);
    std::vector<uint8_t> pool(table_bytes, 1);
    auto* table = reinterpret_cast<AoSBucket*>(pool.data());
    for (uint32_t i = 0; i < CAPACITY; ++i) {
        table[i].key = bucket_keys[i];
    }
    return pool;
}

void launch_case_kernel(
    uint8_t* table, uint64_t* d_keys, uint32_t* d_indices, uint32_t query_num, uint32_t blocks, aclrtStream stream)
{
    lookup_aos_kernel<<<blocks, THREADS_PER_BLOCK, 0, stream>>>(
        reinterpret_cast<const AoSBucket*>(table), d_keys, d_indices, query_num);
}

#endif

#if SCENARIO_NUM == 1

__global__ __launch_bounds__(THREADS_PER_BLOCK) void lookup_soa_kernel(
    const SoaTable* table, const uint64_t* keys, uint32_t* indices, uint32_t query_num)
{
    const uint32_t stride = gridDim.x * blockDim.x;
    for (uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x; idx < query_num; idx += stride) {
        uint32_t result = NOT_FOUND;
        const uint64_t key = keys[idx];
        if (key != EMPTY_KEY) {
            const uint64_t hashed = murmur3_hash(key);
            const uint32_t start = static_cast<uint32_t>(hashed & (CAPACITY - 1));
            result = find_soa(table, key, start);
        }
        indices[idx] = result;
    }
}

std::vector<uint8_t> build_case_table(const std::vector<uint64_t>& bucket_keys)
{
    constexpr size_t table_bytes = static_cast<size_t>(CAPACITY) * (sizeof(uint64_t) + DIM * sizeof(float));
    std::vector<uint8_t> pool(table_bytes, 1);
    auto* table = reinterpret_cast<SoaTable*>(pool.data());
    for (uint32_t i = 0; i < CAPACITY; ++i) {
        table->key[i] = bucket_keys[i];
    }
    return pool;
}

void launch_case_kernel(
    uint8_t* table, uint64_t* d_keys, uint32_t* d_indices, uint32_t query_num, uint32_t blocks, aclrtStream stream)
{
    lookup_soa_kernel<<<blocks, THREADS_PER_BLOCK, 0, stream>>>(
        reinterpret_cast<const SoaTable*>(table), d_keys, d_indices, query_num);
}

#endif

#if SCENARIO_NUM == 2

__global__ __launch_bounds__(THREADS_PER_BLOCK) void lookup_soa_digest_swar_kernel(
    const SoaTableWithDigest* table, const uint64_t* keys, uint32_t* indices, uint32_t query_num)
{
    const uint32_t stride = gridDim.x * blockDim.x;
    for (uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x; idx < query_num; idx += stride) {
        uint32_t result = NOT_FOUND;
        const uint64_t key = keys[idx];
        if (key != EMPTY_KEY) {
            const uint64_t hashed = murmur3_hash(key);
            const uint32_t start = static_cast<uint32_t>(hashed & (CAPACITY - 1));
            result = find_soa_digest_vcmp(table, key, start, digest_word_of(hashed));
        }
        indices[idx] = result;
    }
}

std::vector<uint8_t> build_case_table(const std::vector<uint64_t>& bucket_keys)
{
    constexpr size_t table_bytes =
        static_cast<size_t>(CAPACITY) * (sizeof(uint8_t) + sizeof(uint64_t) + DIM * sizeof(float));
    std::vector<uint8_t> pool(table_bytes, 1);
    auto* table = reinterpret_cast<SoaTableWithDigest*>(pool.data());
    const uint8_t empty_digest = digest_of(murmur3_hash(EMPTY_KEY));
    for (uint32_t i = 0; i < CAPACITY; ++i) {
        table->key[i] = bucket_keys[i];
        table->digest[i] = (bucket_keys[i] == EMPTY_KEY) ? empty_digest : digest_of(murmur3_hash(bucket_keys[i]));
    }
    return pool;
}

void launch_case_kernel(
    uint8_t* table, uint64_t* d_keys, uint32_t* d_indices, uint32_t query_num, uint32_t blocks, aclrtStream stream)
{
    lookup_soa_digest_swar_kernel<<<blocks, THREADS_PER_BLOCK, 0, stream>>>(
        reinterpret_cast<const SoaTableWithDigest*>(table), d_keys, d_indices, query_num);
}

#endif

#if SCENARIO_NUM == 3

__global__ __launch_bounds__(THREADS_PER_BLOCK) void lookup_coop_swar_kernel(
    const SoaTableWithDigest* table, const uint64_t* keys, uint32_t* indices, uint32_t query_num)
{
    constexpr uint32_t kGroupSize = 4;
    constexpr uint32_t kBucketsPerLane = 4;
    constexpr uint32_t kWindow = kGroupSize * kBucketsPerLane;
    constexpr uint32_t kGroupsPerWarp = warpSize / kGroupSize;
    constexpr uint32_t kGroupMask = (1u << kGroupSize) - 1u;
    constexpr uint32_t kMaxRounds = CAPACITY / kWindow + 1;

    const uint32_t tid = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t lane_id = tid % warpSize;
    const uint32_t group_id = lane_id / kGroupSize;
    const uint32_t rank = lane_id % kGroupSize;
    const uint32_t group_shift = group_id * kGroupSize;
    const uint64_t warp_id = tid / warpSize;
    const uint64_t warp_total = (static_cast<uint64_t>(gridDim.x) * blockDim.x) / warpSize;

    const uint32_t empty_word = digest_word_of(murmur3_hash(EMPTY_KEY));

    for (uint64_t base = warp_id * kGroupsPerWarp; base < query_num; base += warp_total * kGroupsPerWarp) {
        const uint64_t key_idx = base + group_id;
        const bool active = key_idx < query_num;
        const uint64_t key = active ? keys[key_idx] : 0;

        bool found = false;
        bool done = !active;
        uint32_t start = 0;
        uint32_t target_word = 0;
        uint32_t match_idx = NOT_FOUND;
        if (active && key != EMPTY_KEY) {
            const uint64_t hashed = murmur3_hash(key);
            start = static_cast<uint32_t>(hashed & (CAPACITY - 1));
            target_word = digest_word_of(hashed);
        } else {
            done = true;
        }
        const uint32_t first_pos = start & (CAPACITY - kWindow);

        for (uint32_t round = 0; round < kMaxRounds; ++round) {
            if (asc_all(done)) {
                break;
            }
            const bool working = !done;
            const uint32_t pos = (first_pos + round * kWindow + rank * kBucketsPerLane) & (CAPACITY - 1);

            uint32_t tmask = 0;
            uint32_t emask = 0;
            if (working) {
                const uint32_t word = *reinterpret_cast<const uint32_t*>(table->digest + pos);
                tmask = vcmp_eq4(word, target_word) & 0x01010101u;
                emask = vcmp_eq4(word, empty_word) & 0x01010101u;
                if (round == 0) {
                    const uint32_t shift =
                        (start > pos) ? (kBucketsPerLane < start - pos ? kBucketsPerLane : start - pos) : 0u;
                    emask &= ~static_cast<uint32_t>((1ull << (shift * 8)) - 1ull);
                }
            }

            bool match = false;
            while (tmask != 0) {
                const uint32_t idx = pos + (((static_cast<uint32_t>(__ffs(static_cast<int32_t>(tmask)))) - 1u) >> 3);
                tmask &= tmask - 1;
                if (table->key[idx] == key) {
                    match = true;
                    match_idx = idx;
                }
            }
            bool miss_confirmed = false;
            while (emask != 0) {
                const uint32_t idx = pos + (((static_cast<uint32_t>(__ffs(static_cast<int32_t>(emask)))) - 1u) >> 3);
                emask &= emask - 1;
                if (table->key[idx] == EMPTY_KEY) {
                    miss_confirmed = true;
                }
            }

            const uint32_t match_ballot = asc_ballot(match);
            if (((match_ballot >> group_shift) & kGroupMask) != 0) {
                found = true;
                done = true;
            }
            const uint32_t confirm_ballot = asc_ballot(miss_confirmed);
            if (((confirm_ballot >> group_shift) & kGroupMask) != 0) {
                done = true;
            }
        }

        if (active) {
            if (found) {
                if (match_idx != NOT_FOUND) {
                    indices[key_idx] = match_idx;
                }
            } else if (rank == 0) {
                indices[key_idx] = NOT_FOUND;
            }
        }
    }
}

std::vector<uint8_t> build_case_table(const std::vector<uint64_t>& bucket_keys)
{
    constexpr size_t table_bytes =
        static_cast<size_t>(CAPACITY) * (sizeof(uint8_t) + sizeof(uint64_t) + DIM * sizeof(float));
    std::vector<uint8_t> pool(table_bytes, 1);
    auto* table = reinterpret_cast<SoaTableWithDigest*>(pool.data());
    const uint8_t empty_digest = digest_of(murmur3_hash(EMPTY_KEY));
    for (uint32_t i = 0; i < CAPACITY; ++i) {
        table->key[i] = bucket_keys[i];
        table->digest[i] = (bucket_keys[i] == EMPTY_KEY) ? empty_digest : digest_of(murmur3_hash(bucket_keys[i]));
    }
    return pool;
}

void launch_case_kernel(
    uint8_t* table, uint64_t* d_keys, uint32_t* d_indices, uint32_t query_num, uint32_t blocks, aclrtStream stream)
{
    lookup_coop_swar_kernel<<<blocks, THREADS_PER_BLOCK, 0, stream>>>(
        reinterpret_cast<const SoaTableWithDigest*>(table), d_keys, d_indices, query_num);
}

#endif

struct RunResult {
    size_t mismatches;
    size_t actual_hits;
};

RunResult run_case(
    const std::vector<uint64_t>& query_keys, const std::vector<uint32_t>& expected,
    const std::vector<uint64_t>& bucket_keys)
{
    const uint32_t query_num = static_cast<uint32_t>(query_keys.size());
    const size_t query_bytes = static_cast<size_t>(query_num) * sizeof(uint64_t);
    const size_t index_bytes = static_cast<size_t>(query_num) * sizeof(uint32_t);
    const std::vector<uint8_t> table_host = build_case_table(bucket_keys);
    const size_t table_bytes = table_host.size();

    aclInit(nullptr);
    const char* device_env = std::getenv("SOA_AOS_DEVICE");
    const int32_t device_id = device_env ? std::atoi(device_env) : 0;
    aclrtSetDevice(device_id);

    const uint32_t core_num = query_aiv_core_num(device_id);
    const uint32_t blocks = std::min(core_num, (query_num + THREADS_PER_BLOCK - 1) / THREADS_PER_BLOCK);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* d_table = nullptr;
    uint64_t* d_keys = nullptr;
    uint32_t* d_indices = nullptr;
    aclrtMalloc((void**)&d_table, table_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&d_keys, query_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&d_indices, index_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(d_table, table_bytes, table_host.data(), table_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(d_keys, query_bytes, query_keys.data(), query_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    launch_case_kernel(d_table, d_keys, d_indices, query_num, blocks, stream);
    aclrtSynchronizeStream(stream);

    std::vector<uint32_t> indices_host(query_num);
    aclrtMemcpy(indices_host.data(), index_bytes, d_indices, index_bytes, ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(d_table);
    aclrtFree(d_keys);
    aclrtFree(d_indices);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        std::fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    RunResult result = {0, 0};
    for (size_t i = 0; i < query_num; ++i) {
        const bool found = indices_host[i] != NOT_FOUND;
        result.actual_hits += found ? 1 : 0;
        result.mismatches += (indices_host[i] != expected[i]) ? 1 : 0;
    }
    return result;
}

int32_t main(int32_t argc, char* argv[])
{
    std::vector<uint64_t> query_keys;
    std::vector<uint32_t> expected;
    std::vector<uint64_t> bucket_keys;
    size_t expected_hits = 0;
    prepare_query_data(query_keys, expected, bucket_keys, expected_hits);

    const RunResult result = run_case(query_keys, expected, bucket_keys);

    return verify_result(result.mismatches, result.actual_hits, expected_hits);
}
