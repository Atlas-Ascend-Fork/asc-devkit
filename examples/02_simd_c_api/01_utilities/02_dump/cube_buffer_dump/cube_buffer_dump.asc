/*!
 * \file cube_buffer_dump.asc
 * \brief 以dav-3510 HiFloat8量化MatMul为背景，打印L1、Bias Table Buffer和Fixpipe Buffer中的关键数据
 */

#include <cstdint>
#include <iostream>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "utils/debug/asc_dump.h"
#include "utils/debug/asc_printf.h"
#include "data_utils.h"

namespace {
constexpr uint32_t MATMUL_M = 16;
constexpr uint32_t MATMUL_N = 16;
constexpr uint32_t MATMUL_K = 32;
constexpr uint32_t A_ELEMENT_COUNT = MATMUL_M * MATMUL_K;
constexpr uint32_t B_ELEMENT_COUNT = MATMUL_K * MATMUL_N;
constexpr uint32_t BIAS_ELEMENT_COUNT = MATMUL_N;
constexpr uint32_t QUANT_ELEMENT_COUNT = MATMUL_N;
constexpr uint32_t OUTPUT_ELEMENT_COUNT = MATMUL_M * MATMUL_N;
constexpr uint32_t A_L1_DUMP_ELEMENT_COUNT = 32;
constexpr uint32_t MMAD_N = 32;
constexpr uint32_t B_L1_ELEMENT_COUNT = MATMUL_K * MMAD_N;
constexpr uint32_t L0C_ELEMENT_COUNT = MATMUL_M * MMAD_N;

constexpr uint32_t A_DATA_BYTES = A_ELEMENT_COUNT * sizeof(uint8_t);
constexpr uint32_t B_DATA_BYTES = B_ELEMENT_COUNT * sizeof(uint8_t);
constexpr uint32_t B_L1_DATA_BYTES = B_L1_ELEMENT_COUNT * sizeof(uint8_t);
constexpr uint32_t BIAS_DATA_BYTES = BIAS_ELEMENT_COUNT * sizeof(float);
constexpr uint32_t QUANT_DATA_BYTES = QUANT_ELEMENT_COUNT * sizeof(uint64_t);
constexpr uint32_t OUTPUT_DATA_BYTES = OUTPUT_ELEMENT_COUNT * sizeof(uint16_t);
} // namespace

__global__ __cube__ void quant_matmul_hifp8(
    __gm__ uint8_t* a_input, __gm__ uint8_t* b_input, __gm__ uint8_t* bias_input, __gm__ uint8_t* quant_input,
    __gm__ uint8_t* output)
{
    asc_init();
    __gm__ hifloat8_t* a_gm = reinterpret_cast<__gm__ hifloat8_t*>(a_input);
    __gm__ hifloat8_t* b_gm = reinterpret_cast<__gm__ hifloat8_t*>(b_input);
    __gm__ float* bias_gm = reinterpret_cast<__gm__ float*>(bias_input);
    __gm__ uint64_t* quant_gm = reinterpret_cast<__gm__ uint64_t*>(quant_input);
    __gm__ bfloat16_t* output_gm = reinterpret_cast<__gm__ bfloat16_t*>(output);
    __cbuf__ hifloat8_t a_l1[A_ELEMENT_COUNT];
    __cbuf__ hifloat8_t b_l1[B_L1_ELEMENT_COUNT];
    __cbuf__ float bias_l1[BIAS_ELEMENT_COUNT];
    __cbuf__ uint64_t quant_l1[QUANT_ELEMENT_COUNT];
    __biasbuf__ float bias_bt[BIAS_ELEMENT_COUNT];
    __fbuf__ uint64_t quant_fixpipe[QUANT_ELEMENT_COUNT];
    __ca__ hifloat8_t a_l0[A_ELEMENT_COUNT];
    __cb__ hifloat8_t b_l0[B_L1_ELEMENT_COUNT];
    __cc__ float c_l0[L0C_ELEMENT_COUNT];

    asc_set_gm2l1_nz_para(1, 1, MATMUL_M, 0);
    asc_copy_gm2l1_nd2nz(
        a_l1, a_gm, MATMUL_K, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, MATMUL_M, MATMUL_K, 0, false);
    asc_set_gm2l1_nz_para(1, 1, MATMUL_K, 0);
    asc_copy_gm2l1_nd2nz(
        b_l1, b_gm, MATMUL_N, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, MATMUL_K, MATMUL_N, 0, false);
    asc_set_gm2l1_nz_para(1, 1, 1, 0);
    asc_copy_gm2l1_nd2nz(
        bias_l1, bias_gm, BIAS_DATA_BYTES, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, 1, MATMUL_N, 0, false);
    asc_copy_gm2l1(quant_l1, quant_gm, 1, QUANT_DATA_BYTES / 32, asc_channel_pad_mode::NONE, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_sync_notify(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_FIX, EVENT_ID0);

    __asc_aicore::printf("========== quant_matmul_hifp8 matrix A in L1 Buffer ==========\n");
    asc_dump_l1buf(a_l1, 100, A_L1_DUMP_ELEMENT_COUNT);
    __asc_aicore::printf("========== quant_matmul_hifp8 bias in L1 Buffer ==========\n");
    asc_dump_l1buf(bias_l1, 101, BIAS_ELEMENT_COUNT);
    __asc_aicore::printf("========== quant_matmul_hifp8 per-channel scale in L1 Buffer ==========\n");
    asc_dump_l1buf(quant_l1, 102, QUANT_ELEMENT_COUNT);

    asc_copy_l12bt(0, bias_l1, BIAS_DATA_BYTES);
    asc_copy_l12fb(quant_fixpipe, quant_l1, 1, QUANT_DATA_BYTES / 64, 0, 0);
    asc_copy_l12l0a(a_l0, a_l1, 0, 0, 1, 1, 1, 1);
    asc_copy_l12l0b_transpose(b_l0, b_l1, 0, 0, 2, 1, 2, 1);
    asc_sync_pipe(PIPE_ALL);
    __asc_aicore::printf("========== quant_matmul_hifp8 bias in Bias Table Buffer ==========\n");
    asc_dump(bias_bt, 201, BIAS_ELEMENT_COUNT);
    __asc_aicore::printf("========== quant_matmul_hifp8 per-channel scale in Fixpipe Buffer ==========\n");
    asc_dump(quant_fixpipe, 301, QUANT_ELEMENT_COUNT);

    asc_mmad(
        c_l0, a_l0, b_l0, static_cast<uint64_t>(0), MATMUL_M, MATMUL_K, MMAD_N, asc_unit_flag_mode::DISABLE, false);
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    const uint64_t quant_addr = static_cast<uint64_t>(reinterpret_cast<uintptr_t>(quant_fixpipe)) / 128;
    asc_set_l0c_copy_config(0, quant_addr, false);
    asc_set_l0c_copy_nz_para(1, 0, 0);
    asc_copy_l0c2gm(
        output_gm, c_l0, MATMUL_N, MATMUL_M, MATMUL_N, MATMUL_M, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
        asc_unit_flag_mode::DISABLE, QuantMode_t::VQF322BF16_PRE, asc_relu_pre_mode::NONE, false, true, false, false);
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    std::vector<uint8_t> a_input(A_ELEMENT_COUNT);
    std::vector<uint8_t> b_input(B_ELEMENT_COUNT);
    std::vector<float> bias_input(BIAS_ELEMENT_COUNT);
    std::vector<uint64_t> quant_input(QUANT_ELEMENT_COUNT);
    std::vector<uint16_t> output(OUTPUT_ELEMENT_COUNT);
    size_t a_file_size = A_DATA_BYTES;
    size_t b_file_size = B_DATA_BYTES;
    size_t bias_file_size = BIAS_DATA_BYTES;
    size_t quant_file_size = QUANT_DATA_BYTES;
    if (!ReadFile("./input/a_gm.bin", a_file_size, a_input.data(), A_DATA_BYTES) || a_file_size != A_DATA_BYTES ||
        !ReadFile("./input/b_gm.bin", b_file_size, b_input.data(), B_DATA_BYTES) || b_file_size != B_DATA_BYTES ||
        !ReadFile("./input/bias_gm.bin", bias_file_size, bias_input.data(), BIAS_DATA_BYTES) ||
        bias_file_size != BIAS_DATA_BYTES ||
        !ReadFile("./input/scale_gm.bin", quant_file_size, quant_input.data(), QUANT_DATA_BYTES) ||
        quant_file_size != QUANT_DATA_BYTES) {
        std::cerr << "Read input failed" << std::endl;
        return 1;
    }

    uint8_t* a_device = nullptr;
    uint8_t* b_device = nullptr;
    uint8_t* bias_device = nullptr;
    uint8_t* quant_device = nullptr;
    uint8_t* output_device = nullptr;
    int32_t device_id = 0;
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    aclrtMalloc((void**)&a_device, A_DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&b_device, B_DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bias_device, BIAS_DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&quant_device, QUANT_DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_device, OUTPUT_DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(a_device, A_DATA_BYTES, a_input.data(), A_DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(b_device, B_DATA_BYTES, b_input.data(), B_DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bias_device, BIAS_DATA_BYTES, bias_input.data(), BIAS_DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(quant_device, QUANT_DATA_BYTES, quant_input.data(), QUANT_DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);

    quant_matmul_hifp8<<<1, 0, stream>>>(a_device, b_device, bias_device, quant_device, output_device);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(output.data(), OUTPUT_DATA_BYTES, output_device, OUTPUT_DATA_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    bool write_success = WriteFile("./output/output.bin", output.data(), OUTPUT_DATA_BYTES);

    aclrtFree(output_device);
    aclrtFree(quant_device);
    aclrtFree(bias_device);
    aclrtFree(b_device);
    aclrtFree(a_device);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return write_success ? 0 : 1;
}
