/*!
 * \file simd_vf_dump.asc
 * \brief 使用vector编程模式，展示simd_vf侧asc_dump_ubuf/asc_dump/asc_dump_reg接口的基本使用方法
 */

#include <array>
#include <cmath>
#include <cstdint>
#include <iostream>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "utils/debug/asc_dump.h"
#include "utils/debug/asc_printf.h"
#include "utils/std/cmath.h"

namespace {
constexpr uint32_t DATA_LEN = 32;
constexpr uint32_t REG_COUNT = 32;
} // namespace

// simd_vf dump演示: 使用asc_dump_ubuf打印UB数据
__simd_vf__ inline void dump_ubuf_data(__ubuf__ float* x)
{
    asc_dump_ubuf<float>(x, 5, 32);
    asc_dump<float>(x, 5, 16);
}

// simd_vf dump演示: 使用asc_dump_reg打印Reg数据
__simd_vf__ inline void dump_reg_data(__ubuf__ float* x)
{
    vector_float src_reg;
    vector_bool mask_reg;
    uint32_t count = REG_COUNT;
    mask_reg = asc_update_mask_b32(count);
    asc_loadalign(src_reg, x);
    asc_duplicate_scalar(src_reg, 3.0f, mask_reg);

    asc_dump_reg<float>(src_reg, 5, 32);
    asc_duplicate_scalar(src_reg, 4.0f, mask_reg);
    asc_dump<float>(src_reg, 5, 16);
}

__simd_vf__ inline void modified_ubuf_vf(__ubuf__ float* x_local, uint32_t count)
{
    constexpr uint32_t one_repeat_size = asc_get_vf_len() / sizeof(float);
    const uint16_t repeat_times = static_cast<uint16_t>(AscendC::Std::ceil_div(count, one_repeat_size));
    vector_float x_reg;
    vector_float y_reg;
    vector_bool mask;
    for (uint16_t i = 0; i < repeat_times; ++i) {
        mask = asc_update_mask_b32(count);
        asc_loadalign(x_reg, x_local + i * one_repeat_size);
        asc_add_scalar(y_reg, x_reg, 1.0f, mask);
        asc_storealign(x_local + i * one_repeat_size, y_reg, mask);
    }
}

// simd_vf dump演示: 使用asc_dump打印UB数据
__simd_vf__ inline void dump_modified_ubuf(__ubuf__ float* x) { asc_dump<float>(x, 5, 32); }

__global__ __vector__ void simd_vf_dump_kernel(__gm__ uint8_t* x, __gm__ uint8_t* z)
{
    asc_init();
    __ubuf__ float ub_input[DATA_LEN];
    constexpr uint8_t mutex_id = 1;
    asc_lock(PIPE_MTE2, mutex_id);
    asc_copy_gm2ub(ub_input, (__gm__ float*)x, DATA_LEN * sizeof(float));
    asc_unlock(PIPE_MTE2, mutex_id);
    asc_lock(PIPE_V, mutex_id);
    printf("[aicore] simd_vf dump demo start ...\n");

    // 1. 调用asc_dump_ubuf接口：打印UB数据
    printf("========== UB data (asc_dump_ubuf + asc_dump) ==========\n");
    asc_vf_call<dump_ubuf_data>(ub_input);

    // 2. 调用asc_dump_reg接口：从UB加载到Reg后打印Reg数据
    printf("========== Register data (asc_dump_reg + asc_dump) ==========\n");
    asc_vf_call<dump_reg_data>(ub_input);

    // 3. 执行Adds计算（x + 1.0）
    asc_vf_call<modified_ubuf_vf>(ub_input, DATA_LEN);
    // 4. 调用asc_dump接口：打印计算后的UB数据
    printf("========== Modified UB data (asc_dump) ==========\n");
    asc_vf_call<dump_modified_ubuf>(ub_input);
    printf("[aicore] simd_vf dump demo end ...\n");
    asc_unlock(PIPE_V, mutex_id);
    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm((__gm__ float*)z, ub_input, DATA_LEN * sizeof(float));
    asc_unlock(PIPE_MTE3, mutex_id);
}

int32_t main(int32_t argc, char* argv[])
{
    std::array<float, DATA_LEN> input{};
    std::array<float, DATA_LEN> output{};
    for (uint32_t i = 0; i < DATA_LEN; ++i) {
        input[i] = static_cast<float>(i);
    }

    constexpr size_t data_size = DATA_LEN * sizeof(float);
    if (aclInit(nullptr) != ACL_SUCCESS) {
        return 1;
    }
    constexpr int32_t device_id = 0;
    if (aclrtSetDevice(device_id) != ACL_SUCCESS) {
        aclFinalize();
        return 1;
    }

    aclrtStream stream = nullptr;
    float* x_device = nullptr;
    float* z_device = nullptr;
    bool ok = aclrtCreateStream(&stream) == ACL_SUCCESS;
    if (ok) {
        ok = aclrtMalloc((void**)&x_device, data_size, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
    }
    if (ok) {
        ok = aclrtMalloc((void**)&z_device, data_size, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
    }
    if (ok) {
        ok = aclrtMemcpy(x_device, data_size, input.data(), data_size, ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
    }
    if (ok) {
        simd_vf_dump_kernel<<<1, 0, stream>>>(
            reinterpret_cast<uint8_t*>(x_device), reinterpret_cast<uint8_t*>(z_device));
        ok = aclrtSynchronizeStream(stream) == ACL_SUCCESS;
    }
    if (ok) {
        ok = aclrtMemcpy(output.data(), data_size, z_device, data_size, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS;
    }

    if (z_device != nullptr) {
        aclrtFree(z_device);
    }
    if (x_device != nullptr) {
        aclrtFree(x_device);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    aclrtResetDevice(device_id);
    aclFinalize();

    if (!ok) {
        std::cerr << "NPU execution failed" << std::endl;
        return 1;
    }
    for (uint32_t i = 0; i < DATA_LEN; ++i) {
        const float golden = input[i] + 1.0f;
        if (std::abs(output[i] - golden) > 1e-4f) {
            std::cerr << "test failed at " << i << ": expected " << golden << ", got " << output[i] << std::endl;
            return 1;
        }
    }
    std::cout << "test pass!" << std::endl;
    return 0;
}
