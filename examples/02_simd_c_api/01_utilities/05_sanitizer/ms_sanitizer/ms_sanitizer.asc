/*!
 * \file ms_sanitizer.asc
 * \brief 基于Add的msSanitizer调测样例。
 */
#include <algorithm>
#include <cstdint>
#include <iostream>
#include <iterator>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t BLOCK_LENGTH = 2048;

__simd_vf__ inline void add_vf(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z, uint32_t count)
{
    uint32_t remaining = count;
    uint16_t repeat_elems = asc_get_vf_len() / sizeof(float);
    vector_bool mask;
    vector_float lhs, rhs, sum;
    for (uint32_t offset = 0; offset < count; offset += repeat_elems) {
        mask = asc_update_mask_b32(remaining);
        asc_load(lhs, x + offset);
        asc_load(rhs, y + offset);
        asc_add(sum, lhs, rhs, mask);
        asc_store(z + offset, sum);
    }
}

__global__ __vector__ void add_custom(__gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    asc_init();
    __gm__ float* x_gm = x + block_idx * BLOCK_LENGTH;
    __gm__ float* y_gm = y + block_idx * BLOCK_LENGTH;
    // 删除输出地址赋值可触发未初始化检测。
    __gm__ float* z_gm = z + block_idx * BLOCK_LENGTH;
    __ubuf__ float x_local[BLOCK_LENGTH];
    __ubuf__ float y_local[BLOCK_LENGTH];
    __ubuf__ float z_local[BLOCK_LENGTH];
    constexpr uint8_t mutex_id = 1;
    asc_lock(PIPE_MTE2, mutex_id);
    asc_copy_gm2ub(x_local, x_gm, BLOCK_LENGTH * sizeof(float));
    // 错误示例：长度超过UB缓冲区，触发非法读写。
    // asc_copy_gm2ub(x_local, x_gm, BLOCK_LENGTH * 2 * sizeof(float));
    // 错误示例：非32B对齐的目标地址。
    // asc_copy_gm2ub(x_local + 5, x_gm, BLOCK_LENGTH * sizeof(float));
    asc_copy_gm2ub(y_local, y_gm, BLOCK_LENGTH * sizeof(float));
    // 删除这一阶段的解锁与后续锁定可触发RAW竞争。
    asc_unlock(PIPE_MTE2, mutex_id);
    asc_lock(PIPE_V, mutex_id);
    add_vf(x_local, y_local, z_local, BLOCK_LENGTH);
    asc_unlock(PIPE_V, mutex_id);
    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm(z_gm, z_local, BLOCK_LENGTH * sizeof(float));
    asc_unlock(PIPE_MTE3, mutex_id);
}

template <typename T>
std::vector<T> kernel_add(std::vector<T>& x, std::vector<T>& y)
{
    constexpr uint32_t num_blocks = 8;
    constexpr uint32_t block_length = 2048;
    uint32_t total_length = x.size();
    size_t total_byte_size = total_length * sizeof(T);
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    T* x_device = nullptr;
    T* y_device = nullptr;
    T* z_device = nullptr;
    std::vector<T> z(total_length);

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    // 1. 正确的Device侧输入内存申请。
    aclrtMalloc((void**)&x_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    // 2. 错误示例：实际只使用total_byte_size，却申请5倍大小，会触发未使用内存检测。
    // aclrtMalloc((void**)&x_device, total_byte_size * 5, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&z_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(x_device, total_byte_size, x.data(), total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(y_device, total_byte_size, y.data(), total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    add_custom<<<num_blocks, 0, stream>>>(x_device, y_device, z_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(z.data(), total_byte_size, z_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(x_device);
    aclrtFree(y_device);
    // 正确释放Device侧输出内存。删除该行后，可触发内存泄漏检测。
    aclrtFree(z_device);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return z;
}

template <typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden)
{
    auto print_tensor = [](std::vector<T>& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(
            tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<T>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "test pass!" << std::endl;
        return 0;
    } else {
        std::cout << "test failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    using data_type = float;
    constexpr uint32_t total_length = 8 * 2048;
    std::vector<data_type> x(total_length);
    std::vector<data_type> y(total_length);
    for (uint32_t i = 0; i < total_length; ++i) {
        x[i] = static_cast<data_type>(i * 0.1f);
        y[i] = static_cast<data_type>(i * 0.2f);
    }

    std::vector<data_type> output = kernel_add(x, y);

    std::vector<data_type> golden(total_length);
    for (uint32_t i = 0; i < total_length; ++i) {
        golden[i] = x[i] + y[i];
    }
    return verify_result(output, golden);
}
