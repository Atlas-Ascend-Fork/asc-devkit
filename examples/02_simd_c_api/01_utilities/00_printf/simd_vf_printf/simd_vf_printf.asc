/*!
 * \file simd_vf_printf.asc
 * \brief 使用vector编程模式，展示simd_vf printf接口的基本使用方法
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "utils/debug/asc_printf.h"

constexpr uint32_t PRINT_COUNT = 1;
constexpr uint32_t ADD_DATA_LEN = 16;

// simd_vf printf演示: int, uint, float, string格式打印
__simd_vf__ inline void simd_vf_print_format()
{
    __ubuf__ const char* fmt = "[simd_vf] int=%d, uint=%u, float=%f, string=%s\n";
    printf(fmt, 10, 20U, 3.14f, "hello");
}

// simd_vf printf演示: 十六进制和指针格式打印
__simd_vf__ inline void simd_vf_print_hex_ptr()
{
    __ubuf__ const char* fmt = "[simd_vf] hex=%x, ptr=%p\n";
    printf(fmt, 255, (void*)(uintptr_t)0x12ff);
}

// simd_vf printf演示: 纯字符串打印
__simd_vf__ inline void simd_vf_print_str()
{
    __ubuf__ const char* fmt = "[simd_vf] This is a simd_vf printf demo string.\n";
    printf(fmt);
}

// simd_vf printf演示: 打印C API Add计算后的UB结果
__simd_vf__ inline void simd_vf_print_add(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z, uint32_t count)
{
    __ubuf__ const char* fmt = "[simd_vf] add[%u]: %f + %f = %f\n";
    for (uint32_t i = 0; i < count; i++) {
        printf(fmt, i, x[i], y[i], z[i]);
    }
}

__simd_vf__ inline void simd_vf_add(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z)
{
    uint32_t count = ADD_DATA_LEN;
    vector_bool mask = asc_update_mask_b32(count);
    vector_float lhs, rhs, sum;
    asc_loadalign(lhs, x);
    asc_loadalign(rhs, y);
    asc_add(sum, lhs, rhs, mask);
    asc_storealign(z, sum, mask);
}

// AICore侧演示: 固定输入写入UB，使用寄存器C API计算并打印
__aicore__ inline void simd_vf_add_tensor_demo()
{
    __ubuf__ float x_local[ADD_DATA_LEN];
    __ubuf__ float y_local[ADD_DATA_LEN];
    __ubuf__ float z_local[ADD_DATA_LEN];
    for (uint32_t i = 0; i < ADD_DATA_LEN; ++i) {
        x_local[i] = 1.25f;
        y_local[i] = 10.0f;
    }
    asc_vf_call<simd_vf_add>(x_local, y_local, z_local);
    asc_sync_pipe(PIPE_V);
    asc_vf_call<simd_vf_print_add>(x_local, y_local, z_local, PRINT_COUNT);
}

extern "C" __global__ __vector__ void simd_vf_printf_kernel()
{
    asc_init();

    printf("[aicore] simd_vf printf demo start ...\n");
    printf("[aicore] blockIdx=%u\n", block_idx);

    asc_vf_call<simd_vf_print_format>();
    asc_vf_call<simd_vf_print_hex_ptr>();
    asc_vf_call<simd_vf_print_str>();
    simd_vf_add_tensor_demo();

    printf("[aicore] simd_vf printf demo end ...\n");
    asc_sync();
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    simd_vf_printf_kernel<<<1, 0, stream>>>();

    aclrtSynchronizeStream(stream);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
