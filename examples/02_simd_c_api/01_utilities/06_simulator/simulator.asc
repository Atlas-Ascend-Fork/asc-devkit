/*!
 * \file simulator.asc
 * \brief C API MatmulLeakyRelu sample for CAmodel simulation.
 */
#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t M = 512;
constexpr uint32_t K = 128;
constexpr uint32_t N = 128;
constexpr uint32_t SINGLE_CORE_M = 256;
constexpr uint32_t SINGLE_CORE_K = 128;
constexpr uint32_t SINGLE_CORE_N = 128;
constexpr uint32_t BASE_M = 256;
constexpr uint32_t BASE_K = 128;
constexpr uint32_t BASE_N = 128;

__simd_vf__ inline void leaky_relu_vf(__ubuf__ half* data)
{
    constexpr uint32_t LANES = 256 / sizeof(half);
    constexpr uint32_t ELEMENTS = 256 * 128 / 2;
    for (uint32_t offset = 0; offset < ELEMENTS; offset += LANES) {
        uint32_t remaining = LANES;
        vector_bool mask = asc_update_mask_b16(remaining);
        vector_half input, negative, output;
        asc_loadalign(input, data + offset);
        asc_mul_scalar(negative, input, (half)0.001, mask);
        vector_bool positive;
        asc_ge_scalar(positive, input, (half)0, mask);
        asc_select(output, input, negative, positive);
        asc_storealign(data + offset, output, mask);
    }
}

__global__ __mix__(1, 2) void matmul_vec_custom(
    __gm__ uint8_t* x_matrix, __gm__ uint8_t* y_matrix, __gm__ uint8_t* z_matrix)
{
    asc_init();
    if ASC_IS_AIC {
        __gm__ half* a_gm = (__gm__ half*)x_matrix + block_idx * SINGLE_CORE_M * K;
        __gm__ half* b_gm = (__gm__ half*)y_matrix;
        __gm__ half* c_gm = (__gm__ half*)z_matrix + block_idx * SINGLE_CORE_M * N;
        __cbuf__ half a1_local[BASE_M * BASE_K];
        __cbuf__ half b1_local[BASE_K * BASE_N];
        __ca__ half a2_local[BASE_M * BASE_K];
        __cb__ half b2_local[BASE_K * BASE_N];
        __cc__ float c_local[BASE_M * BASE_N];
        asc_set_gm2l1_nz_para(1, 1, BASE_M, 0);
        asc_copy_gm2l1_nd2nz(
            a1_local, a_gm, K * sizeof(half), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, BASE_M, BASE_K, 0, false);
        asc_set_gm2l1_nz_para(1, 1, BASE_K, 0);
        asc_copy_gm2l1_nd2nz(
            b1_local, b_gm, N * sizeof(half), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, BASE_K, BASE_N, 0, false);
        asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_copy_l12l0a(
            a2_local, a1_local, 0, 0, BASE_M / CUBE_BLOCK, BASE_K / CUBE_BLOCK, BASE_M / CUBE_BLOCK,
            BASE_M / CUBE_BLOCK);
        asc_copy_l12l0b_transpose(
            b2_local, b1_local, 0, 0, BASE_K / CUBE_BLOCK, BASE_N / CUBE_BLOCK, BASE_K / CUBE_BLOCK,
            BASE_N / CUBE_BLOCK);
        asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
        asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
        asc_mmad(c_local, a2_local, b2_local, BASE_M, BASE_K, BASE_N, asc_unit_flag_mode::DISABLE, false, false, true);
        asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_set_l0c_copy_nz_para(1, 0, 0);
        asc_copy_l0c2gm(
            c_gm, c_local, BASE_N, BASE_M, N, BASE_M, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
            asc_unit_flag_mode::DISABLE, QuantMode_t::F322F16, asc_relu_pre_mode::NONE, false, true, false, false);
        asc_sync_block_arrive(PIPE_FIX, 0x8);
    }
    if ASC_IS_AIV {
        constexpr uint32_t tile_len = BASE_M / 2 * BASE_N;
        __gm__ half* c_gm = (__gm__ half*)z_matrix + block_idx * SINGLE_CORE_M * N + asc_get_sub_block_id() * tile_len;
        __ubuf__ half vec_local[tile_len];
        asc_sync_block_wait(PIPE_MTE2, 0x8);
        asc_copy_gm2ub_align(vec_local, c_gm, tile_len * sizeof(half));
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_vf_call<leaky_relu_vf>(vec_local);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm_align(c_gm, vec_local, tile_len * sizeof(half));
    }
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    size_t a_file_size = M * K * sizeof(half);
    size_t b_file_size = K * N * sizeof(half);
    size_t c_file_size = M * N * sizeof(half);
    uint32_t num_blocks = (M / SINGLE_CORE_M) * (N / SINGLE_CORE_N);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* a_host = nullptr;
    uint8_t* a_device = nullptr;
    aclrtMallocHost((void**)(&a_host), a_file_size);
    aclrtMalloc((void**)&a_device, a_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", a_file_size, a_host, a_file_size);
    aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* b_host = nullptr;
    uint8_t* b_device = nullptr;
    aclrtMallocHost((void**)(&b_host), b_file_size);
    aclrtMalloc((void**)&b_device, b_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", b_file_size, b_host, b_file_size);
    aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* c_host = nullptr;
    uint8_t* c_device = nullptr;
    aclrtMallocHost((void**)(&c_host), c_file_size);
    aclrtMalloc((void**)&c_device, c_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    matmul_vec_custom<<<num_blocks, 0, stream>>>(a_device, b_device, c_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", c_host, c_file_size);

    aclrtFree(a_device);
    aclrtFreeHost(a_host);
    aclrtFree(b_device);
    aclrtFreeHost(b_host);
    aclrtFree(c_device);
    aclrtFreeHost(c_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
