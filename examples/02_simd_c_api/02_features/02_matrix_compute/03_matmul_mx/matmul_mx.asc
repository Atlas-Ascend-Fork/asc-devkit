#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t matrix_m = 8192;
constexpr uint32_t matrix_n = 8192;
constexpr uint32_t matrix_k = 8192;
constexpr uint32_t scale_k = matrix_k / 32;
constexpr uint32_t block_m = 256;
constexpr uint32_t block_n = 256;
constexpr uint32_t block_k = 128;
constexpr uint32_t core_m = 2048;
constexpr uint32_t core_n = 1024;
constexpr uint32_t num_blocks = 32;
constexpr uint32_t l0_buffer_bytes = 32 * 1024;
constexpr uint32_t k_rounds = matrix_k / block_k;
constexpr uint32_t data_step = 2;
constexpr uint32_t scale_step = 8;
constexpr uint32_t data_k = block_k * data_step;
constexpr uint32_t scale_chunk = block_k * scale_step / 32;
constexpr uint32_t a_bytes = block_m * data_k;
constexpr uint32_t b_bytes = block_n * data_k;
constexpr uint32_t scale_a_bytes = block_m * scale_chunk;
constexpr uint32_t scale_b_bytes = block_n * scale_chunk;
static_assert(2 * (a_bytes + b_bytes + scale_a_bytes + scale_b_bytes) <= 512 * 1024, "L1 Buffer overflow");
static_assert(
    block_m * block_k <= l0_buffer_bytes && block_n * block_k <= l0_buffer_bytes,
    "L0A Buffer/L0B Buffer ping/pong overflow");
static_assert(block_m * block_n * sizeof(float) <= 256 * 1024, "L0C Buffer overflow");
static_assert(matrix_k % data_k == 0 && matrix_k % (block_k * scale_step) == 0, "Full K chunks required");
static_assert(matrix_m % core_m == 0 && matrix_n % core_n == 0, "Full core regions required");
static_assert(core_m % block_m == 0 && core_n % block_n == 0, "Full output blocks required");
static_assert((matrix_m / core_m) * (matrix_n / core_n) == num_blocks, "Expected 32 core regions");

__aicore__ inline void set_nz_config(uint32_t stride)
{
    asc_set_gm2l1_nz_para(((uint64_t)stride << 32) | (1ULL << 16) | 1);
}

__aicore__ inline void copy_data_to_l1(
    __cbuf__ fp8_e4m3fn_t* a_l1, __cbuf__ fp8_e4m3fn_t* b_l1, __gm__ fp8_e4m3fn_t* a, __gm__ fp8_e4m3fn_t* b,
    uint32_t k_idx)
{
    set_nz_config(block_m);
    asc_copy_gm2l1_nd2nz(
        (__cbuf__ uint8_t*)a_l1, (__gm__ uint8_t*)(a + k_idx * block_k), matrix_k,
        asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, block_m, data_k, 0, false);
    set_nz_config(block_n);
    asc_copy_gm2l1_nd2nz(
        (__cbuf__ uint8_t*)b_l1, (__gm__ uint8_t*)(b + k_idx * block_k), matrix_k,
        asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, block_n, data_k, 0, false);
}

__aicore__ inline void copy_scale_to_l1(
    __cbuf__ fp8_e8m0_t* scale_a_l1, __cbuf__ fp8_e8m0_t* scale_b_l1, __gm__ fp8_e8m0_t* a_scale,
    __gm__ fp8_e8m0_t* b_scale, uint32_t k_idx)
{
    // Dn2Nz.b16 keeps each pair of scale values for adjacent groups of 32 K elements together. GM stride is in bytes.
    set_nz_config(scale_chunk / 2);
    asc_copy_gm2l1_dn2nz(
        (__cbuf__ half*)scale_a_l1, (__gm__ half*)(a_scale + k_idx * block_k / 32), scale_k,
        asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, scale_chunk / 2, block_m, 0, false);
    asc_copy_gm2l1_dn2nz(
        (__cbuf__ half*)scale_b_l1, (__gm__ half*)(b_scale + k_idx * block_k / 32), scale_k,
        asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, scale_chunk / 2, block_n, 0, false);
}

__aicore__ inline void load_to_l0(
    __ca__ fp8_e4m3fn_t* a_dst, __cb__ fp8_e4m3fn_t* b_dst, __cbuf__ fp8_e4m3fn_t* a_l1, __cbuf__ fp8_e4m3fn_t* b_l1,
    __cbuf__ fp8_e8m0_t* scale_a_l1, __cbuf__ fp8_e8m0_t* scale_b_l1, uint32_t data_offset, uint32_t scale_offset_idx)
{
    // FP8 data fractals span 32 K elements; MX scale fractals span 64.
    asc_copy_l12l0a(
        a_dst, a_l1 + data_offset * block_k * block_m, 0, 0, block_m / 16, block_k / 32, block_m / 16, block_m / 16);
    asc_copy_l12l0b(
        b_dst, b_l1 + data_offset * block_k * block_n, 0, 0, block_n / 16, block_k / 32, block_n / 16, block_n / 16);
    uint32_t scale_offset = scale_offset_idx * (block_k / 32) * 16;
    asc_copy_l12l0a_mx(
        (uint64_t)a_dst / 16, scale_a_l1 + scale_offset, 0, 0, block_m / 16, block_k / 64, scale_chunk / 2,
        block_k / 64);
    asc_copy_l12l0b_mx(
        (uint64_t)b_dst / 16, scale_b_l1 + scale_offset, 0, 0, block_n / 16, block_k / 64, scale_chunk / 2,
        block_k / 64);
}

__aicore__ inline void compute_block(
    __cc__ float* c_l0, __ca__ fp8_e4m3fn_t* a_dst, __cb__ fp8_e4m3fn_t* b_dst, uint32_t k_idx, event_t l0_event)
{
    asc_sync_notify(PIPE_MTE1, PIPE_M, l0_event);
    asc_sync_wait(PIPE_MTE1, PIPE_M, l0_event);
    // Only the first MMAD reuses L0C Buffer; input preloads may run before this wait.
    if (k_idx == 0) {
        asc_sync_wait(PIPE_FIX, PIPE_M, EVENT_ID0);
    }
    asc_mmad_mx(c_l0, a_dst, b_dst, block_m, block_k, block_n, asc_unit_flag_mode::DISABLE, false, false, k_idx == 0);
    asc_sync_notify(PIPE_M, PIPE_MTE1, l0_event);
}

__aicore__ inline void copy_result_to_gm(__gm__ half* dst, __cc__ float* c_l0)
{
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_set_l0c_copy_nz_para(1, 0, 0);
    asc_copy_l0c2gm(
        dst, c_l0, block_n, block_m, matrix_n, block_m, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
        asc_unit_flag_mode::DISABLE, QuantMode_t::F322F16, asc_relu_pre_mode::NONE, false, true, false, false);
    // Signal completion; the next output block may preload L1 Buffer/L0A Buffer/L0B Buffer before waiting on this
    // event.
    asc_sync_notify(PIPE_FIX, PIPE_M, EVENT_ID0);
}

// L1 Buffer/L0A Buffer/L0B Buffer pointers; buffers are allocated once and reused for every output block.
struct local_buffers {
    __cbuf__ fp8_e4m3fn_t* a_l1;
    __cbuf__ fp8_e4m3fn_t* b_l1;
    __cbuf__ fp8_e8m0_t* scale_a_l1;
    __cbuf__ fp8_e8m0_t* scale_b_l1;
    __ca__ fp8_e4m3fn_t* a_l0;
    __cb__ fp8_e4m3fn_t* b_l0;
    __cc__ float* c_l0;
};

// Complete one 256 x 256 output block, accumulating all 64 K rounds.
__aicore__ inline void process_output_block(
    const local_buffers* buffers, __gm__ fp8_e4m3fn_t* a_block, __gm__ fp8_e4m3fn_t* b_block,
    __gm__ fp8_e8m0_t* scale_a_block, __gm__ fp8_e8m0_t* scale_b_block, __gm__ half* c_block)
{
    asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
    copy_data_to_l1(buffers->a_l1, buffers->b_l1, a_block, b_block, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID2);
    copy_scale_to_l1(buffers->scale_a_l1, buffers->scale_b_l1, scale_a_block, scale_b_block, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);
    // Track data and scale prefetches independently; each covers a different K span.
    uint32_t next_data = data_step;
    uint32_t next_scale = scale_step;
    for (uint32_t k_idx = 0; k_idx < k_rounds; ++k_idx) {
        uint32_t data_idx = (k_idx / data_step) & 1;
        uint32_t scale_idx = (k_idx / scale_step) & 1;
        event_t data_event = (event_t)data_idx;
        event_t scale_event = (event_t)(scale_idx + 2);
        event_t l0_event = (event_t)(k_idx & 1);
        // Wait for a writable L0A Buffer/L0B Buffer and for the current L1 Buffer data blocks to become ready.
        asc_sync_wait(PIPE_M, PIPE_MTE1, l0_event);
        if (k_idx % data_step == 0) {
            asc_sync_wait(PIPE_MTE2, PIPE_MTE1, data_event);
        }
        if (k_idx % scale_step == 0) {
            asc_sync_wait(PIPE_MTE2, PIPE_MTE1, scale_event);
        }
        __ca__ fp8_e4m3fn_t* a_dst = buffers->a_l0 + (k_idx & 1) * l0_buffer_bytes;
        __cb__ fp8_e4m3fn_t* b_dst = buffers->b_l0 + (k_idx & 1) * l0_buffer_bytes;
        load_to_l0(
            a_dst, b_dst, buffers->a_l1 + data_idx * a_bytes, buffers->b_l1 + data_idx * b_bytes,
            buffers->scale_a_l1 + scale_idx * scale_a_bytes, buffers->scale_b_l1 + scale_idx * scale_b_bytes,
            k_idx % data_step, k_idx % scale_step);
        // Release an L1 Buffer data block only after MTE1 has loaded its last K slice.
        if ((k_idx + 1) % data_step == 0) {
            asc_sync_notify(PIPE_MTE1, PIPE_MTE2, data_event);
        }
        if ((k_idx + 1) % scale_step == 0) {
            asc_sync_notify(PIPE_MTE1, PIPE_MTE2, scale_event);
        }
        compute_block(buffers->c_l0, a_dst, b_dst, k_idx, l0_event);
        // Prefetch the next data block while Cube consumes the current L0A Buffer/L0B Buffer block.
        if ((k_idx == 0 || (k_idx + 1) % data_step == 0) && next_data < k_rounds) {
            uint32_t idx = (next_data / data_step) & 1;
            asc_sync_wait(PIPE_MTE1, PIPE_MTE2, (event_t)idx);
            copy_data_to_l1(buffers->a_l1 + idx * a_bytes, buffers->b_l1 + idx * b_bytes, a_block, b_block, next_data);
            asc_sync_notify(PIPE_MTE2, PIPE_MTE1, (event_t)idx);
            next_data += data_step;
        }
        if ((k_idx == 0 || (k_idx + 1) % scale_step == 0) && next_scale < k_rounds) {
            uint32_t idx = (next_scale / scale_step) & 1;
            asc_sync_wait(PIPE_MTE1, PIPE_MTE2, (event_t)(idx + 2));
            copy_scale_to_l1(
                buffers->scale_a_l1 + idx * scale_a_bytes, buffers->scale_b_l1 + idx * scale_b_bytes, scale_a_block,
                scale_b_block, next_scale);
            asc_sync_notify(PIPE_MTE2, PIPE_MTE1, (event_t)(idx + 2));
            next_scale += scale_step;
        }
    }
    copy_result_to_gm(c_block, buffers->c_l0);
}

__global__ __cube__ void matmul_mx(
    __gm__ fp8_e4m3fn_t* a, __gm__ fp8_e4m3fn_t* b, __gm__ fp8_e8m0_t* a_scale, __gm__ fp8_e8m0_t* b_scale,
    __gm__ half* c)
{
    asc_init();
    __cbuf__ fp8_e4m3fn_t a_l1[2 * a_bytes];
    __cbuf__ fp8_e4m3fn_t b_l1[2 * b_bytes];
    __cbuf__ fp8_e8m0_t scale_a_l1[2 * scale_a_bytes];
    __cbuf__ fp8_e8m0_t scale_b_l1[2 * scale_b_bytes];
    __ca__ fp8_e4m3fn_t a_l0[2 * l0_buffer_bytes];
    __cb__ fp8_e4m3fn_t b_l0[2 * l0_buffer_bytes];
    __cc__ float c_l0[block_m * block_n];
    local_buffers buffers = {a_l1, b_l1, scale_a_l1, scale_b_l1, a_l0, b_l0, c_l0};

    // Seed reverse events so the first producer can write each buffer.
    for (uint32_t id = 0; id < 4; ++id) {
        asc_sync_notify(PIPE_MTE1, PIPE_MTE2, (event_t)id);
    }
    asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID0);
    asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID1);
    asc_sync_notify(PIPE_FIX, PIPE_M, EVENT_ID0);

    // Fixed 4 x 8 core grid, matching the original basic API example.
    uint32_t m_start = block_idx % (matrix_m / core_m) * core_m;
    uint32_t n_start = block_idx / (matrix_m / core_m) * core_n;
    for (uint32_t n = n_start; n < n_start + core_n; n += block_n) {
        for (uint32_t m = m_start; m < m_start + core_m; m += block_m) {
            process_output_block(
                &buffers, a + m * matrix_k, b + n * matrix_k, a_scale + m * scale_k, b_scale + n * scale_k,
                c + m * matrix_n + n);
        }
    }

    // Consume all outstanding reverse events before kernel exit.
    for (uint32_t id = 0; id < 4; ++id) {
        asc_sync_wait(PIPE_MTE1, PIPE_MTE2, (event_t)id);
    }
    asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID1);
    asc_sync_wait(PIPE_FIX, PIPE_M, EVENT_ID0);
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr size_t a_file_size = (size_t)matrix_m * matrix_k;
    constexpr size_t b_file_size = (size_t)matrix_n * matrix_k;
    constexpr size_t scale_a_file_size = (size_t)matrix_m * scale_k;
    constexpr size_t scale_b_file_size = (size_t)matrix_n * scale_k;
    constexpr size_t c_file_size = (size_t)matrix_m * matrix_n * sizeof(uint16_t);
    constexpr int32_t device_id = 0;
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* a_host = nullptr;
    uint8_t* a_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&a_host), a_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&a_device), a_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    read_file("./input/x1_gm.bin", a_host, a_file_size);
    aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* scale_a_host = nullptr;
    uint8_t* scale_a_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&scale_a_host), scale_a_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&scale_a_device), scale_a_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    read_file("./input/x1_scale_gm.bin", scale_a_host, scale_a_file_size);
    aclrtMemcpy(scale_a_device, scale_a_file_size, scale_a_host, scale_a_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* b_host = nullptr;
    uint8_t* b_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&b_host), b_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&b_device), b_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    read_file("./input/x2_gm.bin", b_host, b_file_size);
    aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* scale_b_host = nullptr;
    uint8_t* scale_b_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&scale_b_host), scale_b_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&scale_b_device), scale_b_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    read_file("./input/x2_scale_gm.bin", scale_b_host, scale_b_file_size);
    aclrtMemcpy(scale_b_device, scale_b_file_size, scale_b_host, scale_b_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* c_host = nullptr;
    uint8_t* c_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&c_host), c_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&c_device), c_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    matmul_mx<<<num_blocks, 0, stream>>>(
        reinterpret_cast<fp8_e4m3fn_t*>(a_device), reinterpret_cast<fp8_e4m3fn_t*>(b_device),
        reinterpret_cast<fp8_e8m0_t*>(scale_a_device), reinterpret_cast<fp8_e8m0_t*>(scale_b_device),
        reinterpret_cast<half*>(c_device));
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    write_file("./output/output.bin", c_host, c_file_size);
    aclrtFree(a_device);
    aclrtFreeHost(a_host);
    aclrtFree(scale_a_device);
    aclrtFreeHost(scale_a_host);
    aclrtFree(b_device);
    aclrtFreeHost(b_host);
    aclrtFree(scale_b_device);
    aclrtFreeHost(scale_b_host);
    aclrtFree(c_device);
    aclrtFreeHost(c_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
