/*!
 * \file copy_vector.asc
 * \brief Demonstrate AIV Tensor API data movement patterns.
 */

#include <cstdint>
#include <cstring>
#include <iostream>
#include <type_traits>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"

constexpr uint32_t scenario = SCENARIO_NUM;
constexpr uint32_t row = 32;
constexpr uint32_t col = 32;
constexpr uint32_t total_length = row * col;
constexpr uint8_t buffer_lock_id = 0;
constexpr uint8_t left_padding = 3;
constexpr uint8_t right_padding = 5;
constexpr int8_t padding_value = -9;
constexpr uint32_t padded_data_col = col - left_padding - right_padding;
constexpr uint32_t input_length = scenario == 5 ? row * padded_data_col : total_length;

__aicore__ inline void copy_vector_process(__gm__ int8_t* src, __gm__ int8_t* dst)
{
    using namespace asc::te;
    __ubuf__ int8_t src_ub_buffer[total_length];
    __ubuf__ int8_t dst_ub_buffer[total_length];

    if constexpr (scenario == 1) {
        // GM -> UB, ND: infer copy_gm_to_ub from the tensor locations.
        auto layout = make_frame_layout<nd_ext_layout_ptn, layout_trait_default<int8_t>>(row, col);
        auto src_gm = make_tensor(make_mem_ptr<location::gm>(src), layout);
        auto dst_gm = make_tensor(make_mem_ptr<location::gm>(dst), layout);
        auto src_ub = make_tensor(make_mem_ptr(src_ub_buffer), layout);
        // Stage 1 (MTE2): copy the input data from Global Memory to the Unified Buffer.
        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        copy(src_ub, src_gm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
        // Stage 3 (MTE3): copy the result from the Unified Buffer back to Global Memory.
        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        copy(make_copy(copy_ub_to_gm{}), dst_gm, src_ub);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    } else if constexpr (scenario == 2) {
        using namespace asc::te;
        // UB -> GM, DN: construct the output atom explicitly and invoke it directly.
        auto layout = make_frame_layout<dn_ext_layout_ptn, layout_trait_default<int8_t>>(row, col);
        auto src_gm = make_tensor(make_mem_ptr<location::gm>(src), layout);
        auto dst_gm = make_tensor(make_mem_ptr<location::gm>(dst), layout);
        auto src_ub = make_tensor(make_mem_ptr(src_ub_buffer), layout);
        // Stage 1 (MTE2): copy the input data from Global Memory to the Unified Buffer.
        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        copy(make_copy(copy_gm_to_ub{}), src_ub, src_gm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);

        auto ub_to_gm = make_copy(copy_ub_to_gm{}, ub_to_gm_trait_default{});
        // Stage 3 (MTE3): copy the result from the Unified Buffer back to Global Memory.
        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        ub_to_gm.call(dst_gm, src_ub);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    } else if constexpr (scenario == 3) {
        using namespace asc::te;
        // UB -> UB, NZ: use the coordinate/shape overload for the complete aligned region.
        auto layout = make_frame_layout<nz_layout_ptn, layout_trait_default<int8_t>>(row, col);
        auto src_gm = make_tensor(make_mem_ptr<location::gm>(src), layout);
        auto dst_gm = make_tensor(make_mem_ptr<location::gm>(dst), layout);
        auto src_ub = make_tensor(make_mem_ptr(src_ub_buffer), layout);
        auto dst_ub = make_tensor(make_mem_ptr(dst_ub_buffer), layout);
        // Stage 1 (MTE2): copy the input data from Global Memory to the Unified Buffer.
        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        copy(src_ub, src_gm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);

        auto ub_to_ub = make_copy(copy_ub_to_ub{}, ub_to_ub_trait_default{});
        // Stage 2 (V): load the data from UB into registers, compute, and store the result back to UB.
        asc_lock(pipe_t::PIPE_V, buffer_lock_id);
        copy(ub_to_ub, dst_ub, src_ub, zero_coord, zero_coord, make_shape(row, col));
        asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
        // Stage 3 (MTE3): copy the result from the Unified Buffer back to Global Memory.
        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        copy(dst_gm, dst_ub);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    } else if constexpr (scenario == 4) {
        using namespace asc::te;
        // GM -> UB, one-dimensional: route a linear layout through the dedicated one-dim copy path.
        auto layout = make_layout(make_shape(total_length), make_stride(1));
        auto src_gm = make_tensor(make_mem_ptr<location::gm>(src), layout);
        auto dst_gm = make_tensor(make_mem_ptr<location::gm>(dst), layout);
        auto src_ub = make_tensor(make_mem_ptr(src_ub_buffer), layout);
        // Stage 1 (MTE2): copy the input data from Global Memory to the Unified Buffer.
        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        copy(make_copy(copy_gm_to_ub{}), src_ub, src_gm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
        // Stage 3 (MTE3): copy the result from the Unified Buffer back to Global Memory.
        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        copy(make_copy(copy_ub_to_gm{}), dst_gm, src_ub);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    } else if constexpr (scenario == 5) {
        using namespace asc::te;
        // GM -> UB, ND: add constant padding to both sides of every source row.
        auto src_layout = make_frame_layout<nd_ext_layout_ptn, layout_trait_default<int8_t>>(row, padded_data_col);
        auto dst_layout = make_frame_layout<nd_ext_layout_ptn, layout_trait_default<int8_t>>(row, col);
        auto src_gm = make_tensor(make_mem_ptr<location::gm>(src), src_layout);
        auto dst_ub = make_tensor(make_mem_ptr(dst_ub_buffer), dst_layout);
        auto dst_gm = make_tensor(make_mem_ptr<location::gm>(dst), dst_layout);

        constexpr gm_to_ub_params padding_params{left_padding, right_padding, true};
        // Stage 1 (MTE2): copy the input data from Global Memory to the Unified Buffer.
        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        asc_set_copy_pad_val(padding_value);
        copy(make_copy(copy_gm_to_ub{}).with(padding_params), dst_ub, src_gm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
        // Stage 3 (MTE3): copy the result from the Unified Buffer back to Global Memory.
        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        copy(dst_gm, dst_ub);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    }
}

__global__ __vector__ void copy_vector(__gm__ uint8_t* src, __gm__ uint8_t* dst)
{
    copy_vector_process(reinterpret_cast<__gm__ int8_t*>(src), reinterpret_cast<__gm__ int8_t*>(dst));
}

static bool check_acl(aclError result, const char* api_name)
{
    if (result != ACL_SUCCESS) {
        ERROR_LOG("%s failed, error code = %d", api_name, static_cast<int32_t>(result));
        return false;
    }
    return true;
}

static bool compare_result(const void* output_data, size_t output_size)
{
    void* golden_data = nullptr;
    if (!check_acl(aclrtMallocHost(&golden_data, output_size), "aclrtMallocHost golden_data")) {
        return false;
    }

    size_t golden_size = output_size;
    const bool read_success = read_file("./output/golden.bin", golden_size, golden_data, output_size);
    const bool matched =
        read_success && golden_size == output_size && std::memcmp(output_data, golden_data, output_size) == 0;
    (void)check_acl(aclrtFreeHost(golden_data), "aclrtFreeHost golden_data");
    return matched;
}

static bool run_scenario(aclrtStream stream)
{
    constexpr size_t input_size = input_length * sizeof(int8_t);
    constexpr size_t output_size = total_length * sizeof(int8_t);
    uint8_t* src_host = nullptr;
    uint8_t* dst_host = nullptr;
    uint8_t* src_device = nullptr;
    uint8_t* dst_device = nullptr;
    size_t read_size = input_size;
    bool success = false;

    if (!check_acl(aclrtMallocHost(reinterpret_cast<void**>(&src_host), input_size), "aclrtMallocHost src") ||
        !check_acl(aclrtMallocHost(reinterpret_cast<void**>(&dst_host), output_size), "aclrtMallocHost dst") ||
        !check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&src_device), input_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc src") ||
        !check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&dst_device), output_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc dst")) {
        goto cleanup;
    }

    if (!read_file("./input/input_x.bin", read_size, src_host, input_size) || read_size != input_size ||
        !check_acl(
            aclrtMemcpy(src_device, input_size, src_host, input_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy host to device")) {
        goto cleanup;
    }

    copy_vector<<<1, 0, stream>>>(src_device, dst_device);
    if (!check_acl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") ||
        !check_acl(
            aclrtMemcpy(dst_host, output_size, dst_device, output_size, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy device to host") ||
        !write_file("./output/output.bin", dst_host, output_size)) {
        goto cleanup;
    }
    success = compare_result(dst_host, output_size);

cleanup:
    if (src_device != nullptr) {
        (void)aclrtFree(src_device);
    }
    if (dst_device != nullptr) {
        (void)aclrtFree(dst_device);
    }
    if (src_host != nullptr) {
        (void)aclrtFreeHost(src_host);
    }
    if (dst_host != nullptr) {
        (void)aclrtFreeHost(dst_host);
    }
    return success;
}

int32_t main()
{
    if (!check_acl(aclInit(nullptr), "aclInit")) {
        return 1;
    }

    constexpr int32_t device_id = 0;
    aclrtStream stream = nullptr;
    bool success = check_acl(aclrtSetDevice(device_id), "aclrtSetDevice") &&
                   check_acl(aclrtCreateStream(&stream), "aclrtCreateStream");
    if (success) {
        success = run_scenario(stream);
    }

    std::cout << (success ? "test pass!" : "test failed!") << std::endl;
    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    (void)aclrtResetDevice(device_id);
    (void)aclFinalize();
    return success ? 0 : 1;
}
