#include <cmath>
#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_compute.h"

constexpr uint32_t total_length = 64;
constexpr uint8_t buffer_lock_id = 0;

template <typename Src0TensorType, typename Src1TensorType, typename DstTensorType>
__simd_vf__ inline void compute_add(Src0TensorType src0_tensor, Src1TensorType src1_tensor, DstTensorType dst_tensor)
{
    using namespace asc::te;
    constexpr uint32_t offset = 0;
    const auto coord = make_coord(offset);
    auto mask = experimental::all_mask<float>();
    // Load both operands with all_mask, then add element-wise in registers.
    auto src0 = experimental::load(src0_tensor, coord).with_mask(mask);
    auto src1 = experimental::load(src1_tensor, coord).with_mask(mask);
    auto dst = src0 + src1;
    experimental::store(dst_tensor, coord, dst);
}

class Kernel {
public:
    __aicore__ inline void process(__gm__ float* src0, __gm__ float* src1, __gm__ float* dst)
    {
        using namespace asc::te;
        constexpr uint32_t tensor_bytes = total_length * sizeof(float);
        constexpr uint32_t src0_offset = 0;
        constexpr uint32_t src1_offset = src0_offset + tensor_bytes;
        constexpr uint32_t dst_offset = src1_offset + tensor_bytes;

        auto copy_layout = make_frame_layout<nd_ext_layout_ptn>(1, total_length);
        auto vector_layout = make_layout(make_shape(total_length));
        auto src0_gm = make_tensor(make_mem_ptr<location::gm>(src0), copy_layout);
        auto src1_gm = make_tensor(make_mem_ptr<location::gm>(src1), copy_layout);
        auto dst_gm = make_tensor(make_mem_ptr<location::gm>(dst), copy_layout);

        auto src0_mem = make_mem_ptr<location::ub, float>(src0_offset);
        auto src1_mem = make_mem_ptr<location::ub, float>(src1_offset);
        auto dst_mem = make_mem_ptr<location::ub, float>(dst_offset);
        auto src0_copy_ub = make_tensor(src0_mem, copy_layout);
        auto src1_copy_ub = make_tensor(src1_mem, copy_layout);
        auto dst_copy_ub = make_tensor(dst_mem, copy_layout);
        auto src0_ub = make_tensor(src0_mem, vector_layout);
        auto src1_ub = make_tensor(src1_mem, vector_layout);
        auto dst_ub = make_tensor(dst_mem, vector_layout);

        // Stage 1 (MTE2): copy the input data from Global Memory to the Unified Buffer.
        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        auto copy_in = make_copy(copy_gm_to_ub{});
        copy(copy_in, src0_copy_ub, src0_gm);
        copy(copy_in, src1_copy_ub, src1_gm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);

        // Stage 2 (V): load the data from UB into registers, compute, and store the result back to UB.
        asc_lock(pipe_t::PIPE_V, buffer_lock_id);
        compute_add(src0_ub, src1_ub, dst_ub);
        asc_unlock(pipe_t::PIPE_V, buffer_lock_id);

        // Stage 3 (MTE3): copy the result from the Unified Buffer back to Global Memory.
        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        auto copy_out = make_copy(copy_ub_to_gm{});
        copy(copy_out, dst_gm, dst_copy_ub);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    }
};

__global__ __vector__ void add(__gm__ float* src0, __gm__ float* src1, __gm__ float* dst)
{
    Kernel kernel;
    kernel.process(src0, src1, dst);
}

static bool compare_result(const float* output, const float* src0, const float* src1)
{
    constexpr float eps = 1e-4f;
    for (uint32_t i = 0; i < total_length; ++i) {
        float expected = src0[i] + src1[i];
        if (std::fabs(output[i] - expected) > eps) {
            printf("test failed at index %u: output is %f, expected is %f\n", i, output[i], expected);
            return false;
        }
    }
    printf("test pass!\n");
    return true;
}

int32_t main()
{
    constexpr size_t tensor_bytes = total_length * sizeof(float);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    float* src0_host = nullptr;
    float* src1_host = nullptr;
    float* dst_host = nullptr;
    float* src0_device = nullptr;
    float* src1_device = nullptr;
    float* dst_device = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&src0_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&src1_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&dst_host), tensor_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&src0_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&src1_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dst_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    for (uint32_t i = 0; i < total_length; ++i) {
        src0_host[i] = static_cast<float>(i) * 0.25f - 8.0f;
        src1_host[i] = 3.5f - static_cast<float>(i) * 0.125f;
    }
    aclrtMemcpy(src0_device, tensor_bytes, src0_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src1_device, tensor_bytes, src1_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    add<<<1, 0, stream>>>(src0_device, src1_device, dst_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dst_host, tensor_bytes, dst_device, tensor_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    bool success = compare_result(dst_host, src0_host, src1_host);

    aclrtFree(src0_device);
    aclrtFree(src1_device);
    aclrtFree(dst_device);
    aclrtFreeHost(src0_host);
    aclrtFreeHost(src1_host);
    aclrtFreeHost(dst_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return success ? 0 : 1;
}
