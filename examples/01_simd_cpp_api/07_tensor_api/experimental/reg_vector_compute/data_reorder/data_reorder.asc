#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>

#include "acl/acl.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_ops.h"

constexpr uint32_t total_length = 256;
constexpr uint8_t buffer_lock_id = 0;

template <typename Src0TensorType, typename Src1TensorType, typename Dst0TensorType, typename Dst1TensorType>
__simd_vf__ inline void data_reorder_vf(
    Src0TensorType src0_tensor, Src1TensorType src1_tensor, Dst0TensorType dst0_tensor, Dst1TensorType dst1_tensor,
    uint32_t repeat_times, uint32_t one_repeat_size)
{
    using namespace asc::te;
    for (uint16_t i = 0; i < repeat_times; ++i) {
        uint32_t offset = i * one_repeat_size;
        const auto coord = make_coord(offset);
        auto src0_reg = experimental::load(src0_tensor, coord);
        auto src1_reg = experimental::load(src1_tensor, coord);
        // Deinterleave the two loaded registers: even/odd elements are split into two outputs.
        auto result = experimental::deinterleave(src0_reg, src1_reg);
        experimental::store(dst0_tensor, coord, result.first);
        experimental::store(dst1_tensor, coord, result.second);
    }
}

template <typename DataType>
class Kernel {
public:
    __aicore__ inline void process(
        __gm__ DataType* src0, __gm__ DataType* src1, __gm__ DataType* dst0, __gm__ DataType* dst1)
    {
        using namespace asc::te;
        auto layout = make_layout(make_shape(total_length), make_stride(1));
        auto src0_gm = make_tensor(make_mem_ptr<location::gm>(src0), layout);
        auto src1_gm = make_tensor(make_mem_ptr<location::gm>(src1), layout);
        auto dst0_gm = make_tensor(make_mem_ptr<location::gm>(dst0), layout);
        auto dst1_gm = make_tensor(make_mem_ptr<location::gm>(dst1), layout);

        constexpr uint32_t src0_offset = 0;
        constexpr uint32_t src1_offset = total_length * sizeof(DataType);
        constexpr uint32_t dst0_offset = src1_offset + total_length * sizeof(DataType);
        constexpr uint32_t dst1_offset = dst0_offset + total_length * sizeof(DataType);
        auto src0_ub = make_tensor(make_mem_ptr<location::ub, DataType>(src0_offset), layout);
        auto src1_ub = make_tensor(make_mem_ptr<location::ub, DataType>(src1_offset), layout);
        auto dst0_ub = make_tensor(make_mem_ptr<location::ub, DataType>(dst0_offset), layout);
        auto dst1_ub = make_tensor(make_mem_ptr<location::ub, DataType>(dst1_offset), layout);

        // Stage 1 (MTE2): copy the input data from Global Memory to the Unified Buffer.
        mutex<pipe_t::PIPE_MTE2> copy_in_mutex(buffer_lock_id);
        copy_in_mutex.lock();
        auto copy_in = make_copy(copy_gm_to_ub{});
        copy(copy_in, src0_ub, src0_gm);
        copy(copy_in, src1_ub, src1_gm);
        copy_in_mutex.unlock();
        // Stage 2 (V): load the data from UB into registers, compute, and store the result back to UB.
        mutex<pipe_t::PIPE_V> compute_mutex(buffer_lock_id);
        compute_mutex.lock();
        constexpr uint32_t one_repeat_size = asc::te::get_vf_len() / sizeof(DataType);
        uint16_t repeat_times =
            static_cast<uint16_t>(AscendC::Std::ceil_align(total_length, one_repeat_size) / one_repeat_size);
        data_reorder_vf(src0_ub, src1_ub, dst0_ub, dst1_ub, repeat_times, one_repeat_size);
        compute_mutex.unlock();
        // Stage 3 (MTE3): copy the result from the Unified Buffer back to Global Memory.
        mutex<pipe_t::PIPE_MTE3> copy_out_mutex(buffer_lock_id);
        copy_out_mutex.lock();
        auto copy_out = make_copy(copy_ub_to_gm{});
        copy(copy_out, dst0_gm, dst0_ub);
        copy(copy_out, dst1_gm, dst1_ub);
        copy_out_mutex.unlock();
    }
};

template <typename DataType>
__global__ __vector__ void data_reorder(
    __gm__ uint8_t* src0, __gm__ uint8_t* src1, __gm__ uint8_t* dst0, __gm__ uint8_t* dst1)
{
    using namespace asc::te;
    Kernel<DataType> kernel;
    kernel.process(
        reinterpret_cast<__gm__ DataType*>(src0), reinterpret_cast<__gm__ DataType*>(src1),
        reinterpret_cast<__gm__ DataType*>(dst0), reinterpret_cast<__gm__ DataType*>(dst1));
}

static bool compare_result(const void* output_data, const void* golden_data, uint32_t out_size)
{
    constexpr float eps = 1e-4;
    int64_t wrong_num = 0;

    for (size_t i = 0; i < out_size / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(output_data))[i];
        float b = (reinterpret_cast<const float*>(golden_data))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > eps && re > eps) {
            printf("compare_result golden.bin failed at index %zu: output is %lf, golden is %lf\n", i, a, b);
            wrong_num++;
        }
    }
    if (wrong_num != 0) {
        return false;
    } else {
        printf("compare_result success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t num_blocks = 1;
    size_t byte_size = total_length * sizeof(float);
    uint8_t *src0_host, *src1_host, *dst0_host, *dst1_host;
    uint8_t *src0_device, *src1_device, *dst0_device, *dst1_device;
    aclrtMallocHost((void**)(&src0_host), byte_size);
    aclrtMallocHost((void**)(&src1_host), byte_size);
    aclrtMallocHost((void**)(&dst0_host), byte_size);
    aclrtMallocHost((void**)(&dst1_host), byte_size);
    aclrtMalloc((void**)&src0_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&src1_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst0_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst1_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    size_t file_size = byte_size;
    ReadFile("./input/input_src0.bin", file_size, src0_host, byte_size);
    ReadFile("./input/input_src1.bin", file_size, src1_host, byte_size);
    aclrtMemcpy(src0_device, byte_size, src0_host, byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src1_device, byte_size, src1_host, byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    data_reorder<float><<<num_blocks, 0, stream>>>(src0_device, src1_device, dst0_device, dst1_device);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dst0_host, byte_size, dst0_device, byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(dst1_host, byte_size, dst1_device, byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output_dst0.bin", dst0_host, byte_size);
    WriteFile("./output/output_dst1.bin", dst1_host, byte_size);
    void* g0;
    aclrtMallocHost((void**)(&g0), byte_size);
    size_t gs0 = byte_size;
    ReadFile("./output/golden_dst0.bin", gs0, g0, byte_size);
    bool r0 = compare_result(dst0_host, g0, byte_size);
    aclrtFreeHost(g0);
    void* g1;
    aclrtMallocHost((void**)(&g1), byte_size);
    size_t gs1 = byte_size;
    ReadFile("./output/golden_dst1.bin", gs1, g1, byte_size);
    bool r1 = compare_result(dst1_host, g1, byte_size);
    aclrtFreeHost(g1);
    if (r0 && r1) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    aclrtFree(src0_device);
    aclrtFree(src1_device);
    aclrtFree(dst0_device);
    aclrtFree(dst1_device);
    aclrtFreeHost(src0_host);
    aclrtFreeHost(src1_host);
    aclrtFreeHost(dst0_host);
    aclrtFreeHost(dst1_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
