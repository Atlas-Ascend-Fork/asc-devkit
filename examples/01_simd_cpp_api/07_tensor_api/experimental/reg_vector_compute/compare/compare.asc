#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>

#include "acl/acl.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_ops.h"

constexpr uint32_t total_length = 256;
constexpr uint8_t copy_mutex_id = 0;
constexpr uint32_t scenario_num = SCENARIO_NUM;

template <typename Src0Tensor, typename Src1Tensor, typename DstTensor>
__simd_vf__ inline void compare_vf(
    const Src0Tensor src0, const Src1Tensor src1, DstTensor dst, uint16_t repeat_times, uint32_t total,
    uint32_t one_repeat_size)
{
    using namespace asc::te;
    using data_type = typename Src0Tensor::data_type;
    uint32_t remain = total;
    for (uint16_t i = 0; i < repeat_times; ++i) {
        const uint32_t offset = i * one_repeat_size;
        const auto coord = make_coord(offset);
        auto mask = experimental::update_mask<data_type>(remain);
        auto src0_reg = experimental::load(src0, coord).with_mask(mask);
        auto src1_reg = experimental::load(src1, coord).with_mask(mask);
        auto dst_reg = experimental::select((src0_reg > src1_reg), src0_reg, src1_reg);
        experimental::store(dst, coord, dst_reg);
    }
}

template <typename Src0Tensor, typename Src1Tensor, typename DstTensor, typename Scalar>
__simd_vf__ inline void compares_vf(
    const Src0Tensor src0, const Src1Tensor src1, DstTensor dst, Scalar scalar, uint16_t repeat_times, uint32_t total,
    uint32_t one_repeat_size)
{
    using namespace asc::te;
    using data_type = typename Src0Tensor::data_type;
    uint32_t remain = total;
    for (uint16_t i = 0; i < repeat_times; ++i) {
        const uint32_t offset = i * one_repeat_size;
        const auto coord = make_coord(offset);
        auto mask = experimental::update_mask<data_type>(remain);
        auto src0_reg = experimental::load(src0, coord).with_mask(mask);
        auto src1_reg = experimental::load(src1, coord).with_mask(mask);
        auto dst_reg = experimental::select((src0_reg > scalar), src0_reg, src1_reg);
        experimental::store(dst, coord, dst_reg);
    }
}

template <uint32_t total_length, typename T>
__global__ __vector__ void compare(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z)
{
    using namespace asc::te;
    asc_init();
    auto layout = make_layout(make_shape(total_length));
    auto x_gm = make_tensor(make_mem_ptr((__gm__ T*)x), layout);
    auto y_gm = make_tensor(make_mem_ptr((__gm__ T*)y), layout);
    auto z_gm = make_tensor(make_mem_ptr((__gm__ T*)z), layout);

    __ubuf__ T x_buf[total_length];
    __ubuf__ T y_buf[total_length];
    __ubuf__ T z_buf[total_length];

    auto x_ub = make_tensor(make_mem_ptr(x_buf), layout);
    auto y_ub = make_tensor(make_mem_ptr(y_buf), layout);
    auto z_ub = make_tensor(make_mem_ptr(z_buf), layout);

    // Stage 1 (MTE2): copy the input data from Global Memory to the Unified Buffer.
    asc_lock(pipe_t::PIPE_MTE2, copy_mutex_id);
    copy(make_copy(copy_gm_to_ub{}), x_ub, x_gm);
    copy(make_copy(copy_gm_to_ub{}), y_ub, y_gm);
    asc_unlock(pipe_t::PIPE_MTE2, copy_mutex_id);

    // Stage 2 (V): load the data from UB into registers, compute, and store the result back to UB.
    asc_lock(pipe_t::PIPE_V, copy_mutex_id);
    using reg_type = typename experimental::reg_tensor<T>::reg_type;
    // 一次repeat计算的数据个数
    constexpr uint32_t one_repeat_size = sizeof(reg_type) / sizeof(T);
    // 总迭代次数
    uint16_t repeat_times = AscendC::Std::ceil_division(total_length, one_repeat_size);
    if constexpr (scenario_num == 1) {
        compare_vf(x_ub, y_ub, z_ub, repeat_times, total_length, one_repeat_size);
    } else {
        float scalar = 0;
        compares_vf(x_ub, y_ub, z_ub, scalar, repeat_times, total_length, one_repeat_size);
    }
    asc_unlock(pipe_t::PIPE_V, copy_mutex_id);

    // Stage 3 (MTE3): copy the result from the Unified Buffer back to Global Memory.
    asc_lock(pipe_t::PIPE_MTE3, copy_mutex_id);
    copy(make_copy(copy_ub_to_gm{}), z_gm, z_ub);
    asc_unlock(pipe_t::PIPE_MTE3, copy_mutex_id);
    asc_sync();
}

static bool compare_result(const void* output_data, uint32_t out_size)
{
    void* golden_data;
    aclrtMallocHost((void**)(&golden_data), out_size);
    size_t golden_size = out_size;
    bool ret = ReadFile("./output/golden.bin", golden_size, golden_data, golden_size);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        aclrtFreeHost(golden_data);
        return false;
    }
    constexpr float eps = 1e-4;
    int64_t wrong_num = 0;

    for (size_t i = 0; i < out_size / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(output_data))[i];
        float b = (reinterpret_cast<const float*>(golden_data))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > eps && re > eps) {
            printf("compare_result golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrong_num++;
        }
    }
    aclrtFreeHost(golden_data);
    if (wrong_num != 0) {
        return false;
    } else {
        printf("compare_result golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t num_blocks = 1;
    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    size_t input_byte_size = static_cast<size_t>(1) * total_length * sizeof(float);
    size_t output_byte_size = static_cast<size_t>(1) * total_length * sizeof(float);
    uint8_t *x_host, *y_host, *z_host;
    uint8_t *x_device, *y_device, *z_device;
    aclrtMallocHost((void**)(&x_host), input_byte_size);
    aclrtMallocHost((void**)(&y_host), input_byte_size);
    aclrtMallocHost((void**)(&z_host), output_byte_size);
    aclrtMalloc((void**)&x_device, input_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, input_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&z_device, output_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", input_byte_size, x_host, input_byte_size);
    ReadFile("./input/input_y.bin", input_byte_size, y_host, input_byte_size);
    aclrtMemcpy(x_device, input_byte_size, x_host, input_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(y_device, input_byte_size, y_host, input_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    compare<total_length, float><<<num_blocks, nullptr, stream>>>(x_device, y_device, z_device);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(z_host, output_byte_size, z_device, output_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", z_host, output_byte_size);
    bool golden_result = true;
    golden_result = compare_result(z_host, output_byte_size);
    if (golden_result) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFree(z_device);
    aclrtFreeHost(x_host);
    aclrtFreeHost(y_host);
    aclrtFreeHost(z_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
