/*!
 * \file copy_out_tensor_api.asc
 * \brief copy_out_tensor_api
 */

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

struct MatmulTiling {
    int32_t m;
    int32_t n;
    int32_t k;
    int32_t single_core_m;
    int32_t single_core_n;
    int32_t single_core_k;
};

struct CoreIterInfo {
    uint32_t m_iter;
    uint32_t m_iter_idx;
    uint32_t n_iter_idx;
    int32_t actual_single_core_m;
    int32_t actual_single_core_n;
};

// Custom CopyL0C2UBTrait parameters used only for L0C to UB copies
constexpr asc::te::dual_dst_mode g_dual_dst_mode =
    (SCENARIO_NUM == 3) ? asc::te::dual_dst_mode::split_n : asc::te::dual_dst_mode::split_m;
constexpr asc::te::l0c_to_ub_trait copy_l0c2ub_trait =
    asc::te::l0c_to_ub_trait{asc::te::round_mode::default_round, false, false, g_dual_dst_mode};
struct CopyL0C2UBTraitCustom {
    using TraitType = asc::te::l0c_to_ub_trait;
    static constexpr const TraitType value = copy_l0c2ub_trait;
};

// Copy tiling information from GM to a local struct
__aicore__ inline void copy_tiling_from_gm(__gm__ MatmulTiling* src_info, MatmulTiling& dst_info)
{
    auto src_ptr = reinterpret_cast<__gm__ int32_t*>(src_info);
    auto dst_ptr = reinterpret_cast<int32_t*>(&dst_info);
    for (size_t i = 0; i < sizeof(MatmulTiling) / sizeof(int32_t); ++i) {
        dst_ptr[i] = src_ptr[i];
    }
}

// Calculate iteration information for the current core from tiling parameters and the core index
__aicore__ inline CoreIterInfo calc_core_iter_info(const MatmulTiling& tiling)
{
    uint32_t m_iter = (tiling.m + tiling.single_core_m - 1) / tiling.single_core_m;
    auto block_index = block_idx;
    uint32_t m_iter_idx = block_index % m_iter;
    uint32_t n_iter_idx = block_index / m_iter;
    int32_t actual_single_core_m = tiling.m - m_iter_idx * tiling.single_core_m;
    actual_single_core_m = actual_single_core_m < tiling.single_core_m ? actual_single_core_m : tiling.single_core_m;
    int32_t actual_single_core_n = tiling.n - n_iter_idx * tiling.single_core_n;
    actual_single_core_n = actual_single_core_n < tiling.single_core_n ? actual_single_core_n : tiling.single_core_n;
    return {m_iter, m_iter_idx, n_iter_idx, actual_single_core_m, actual_single_core_n};
}

template <
    typename AType, typename BType, typename CType, typename BiasType, int32_t base_m, int32_t base_n, int32_t base_k,
    int32_t step_m, int32_t step_n, int32_t step_k>
__global__ __mix__(1, 2) void copy_out_tensor_api(
    __gm__ AType* x, __gm__ BType* y, __gm__ CType* z, __gm__ BiasType* bias, __gm__ MatmulTiling* tiling_info)
{
    using namespace asc::te;
    init_soc_state();

    // 1. Copy tiling information from GM
    MatmulTiling tiling;
    copy_tiling_from_gm(tiling_info, tiling);

    // 2. Get SCENARIO_NUM
    constexpr uint32_t scenario_num = SCENARIO_NUM;

    // 3. Calculate iteration information for the current core
    CoreIterInfo iter_info = calc_core_iter_info(tiling);

    int32_t m = tiling.m;
    int32_t n = tiling.n;
    int32_t k = tiling.k;
    int32_t single_core_m = tiling.single_core_m;
    int32_t single_core_n = tiling.single_core_n;
    int32_t single_core_k = tiling.single_core_k;

    // 4. Create GM tensors and slices
    auto gm_ptr_a = make_mem_ptr(x);
    auto gm_ptr_b = make_mem_ptr(y);
    auto gm_ptr_c = make_mem_ptr(z);
    auto gm_ptr_bias = make_mem_ptr(bias);

    auto gm_a = make_tensor(gm_ptr_a, make_frame_layout<nd_ext_layout_ptn>(m, k));
    auto gm_b = make_tensor(gm_ptr_b, make_frame_layout<nd_ext_layout_ptn>(k, n));
    auto gm_c = make_tensor(gm_ptr_c, make_frame_layout<nd_ext_layout_ptn>(m, n));
    auto gm_bias = make_tensor(gm_ptr_bias, make_frame_layout<nd_ext_layout_ptn>(1, n));

    // Slice the current single-core data block from the complete GM tensors.
    auto global_a = gm_a.slice(
        make_coord(iter_info.m_iter_idx * single_core_m, 0), make_shape(iter_info.actual_single_core_m, single_core_k));
    auto global_b = gm_b.slice(
        make_coord(0, iter_info.n_iter_idx * single_core_n), make_shape(single_core_k, iter_info.actual_single_core_n));
    auto global_c = gm_c.slice(
        make_coord(iter_info.m_iter_idx * single_core_m, iter_info.n_iter_idx * single_core_n),
        make_shape(iter_info.actual_single_core_m, iter_info.actual_single_core_n));
    auto global_bias = gm_bias.slice(
        make_coord(0, iter_info.n_iter_idx * single_core_n), make_shape(1, iter_info.actual_single_core_n));
    // 5. Create L1 tensors
    // L1 holds step_m*step_k A-tiles and step_k*step_n B-tiles: the K axis is split into step_k
    // slots so GM->L1 prefetch runs ahead of L1->L0 consumption (slot index = k_iter % step_k).
    auto l1_a_layout = make_frame_layout<nz_layout_ptn, AType>(base_m * step_m, base_k * step_k);
    auto l1_b_layout = make_frame_layout<nz_layout_ptn, BType>(base_k * step_k, base_n * step_n);
    auto l1_bias_layout = make_frame_layout<nd_ext_layout_ptn>(1, base_n * step_n);
    auto ub_layout =
        make_frame_layout<nd_ext_layout_ptn>(iter_info.actual_single_core_m, iter_info.actual_single_core_n);

    __cbuf__ AType l1_a_buf[base_m * step_m * base_k * step_k];
    __cbuf__ BType l1_b_buf[base_k * step_k * base_n * step_n];
    __cbuf__ BiasType l1_bias_buf[base_n * step_n];
    __ca__ AType l0_a_buf[base_m * base_k];
    __cb__ BType l0_b_buf[base_k * base_n];
    __biasbuf__ BiasType l0_bias_buf[base_n];
    __cc__ CType l0_c_buf[base_m * base_n];
    __ubuf__ CType ub_buf[base_m * step_m * base_n * step_n / 2];

    auto l1_a_ptr = make_mem_ptr(l1_a_buf);
    auto l1_b_ptr = make_mem_ptr(l1_b_buf);
    auto l1_bias_ptr = make_mem_ptr(l1_bias_buf);
    auto l0_a_ptr = make_mem_ptr(l0_a_buf);
    auto l0_b_ptr = make_mem_ptr(l0_b_buf);
    auto l0_bias_ptr = make_mem_ptr(l0_bias_buf);
    auto l0_c_ptr = make_mem_ptr(l0_c_buf);
    auto ub_ptr = make_mem_ptr(ub_buf);

    auto l1_a_tensor = make_tensor(l1_a_ptr, l1_a_layout);
    auto l1_b_tensor = make_tensor(l1_b_ptr, l1_b_layout);
    auto l1_bias_tensor = make_tensor(l1_bias_ptr, l1_bias_layout);
    auto ub_tensor = make_tensor(ub_ptr, ub_layout);
    auto copy_gm2l1_atom = make_copy(copy_gm_to_l1{}, gm_to_l1_trait_default{});
    auto copy_l12bt_atom = make_copy(copy_l1_to_biastable{}, l1_to_biastable_trait_default{});
    auto copy_l12l0a_atom = make_copy(copy_l1_to_l0a{}, l1_to_l0a_trait_default{});
    auto copy_l12l0b_atom = make_copy(copy_l1_to_l0b{}, l1_to_l0b_trait_default{});
    auto copy_l0c2gm_atom = make_copy(copy_l0c_to_gm{}, l0c_to_gm_trait_default{});
    auto copy_l0c2ub_atom = make_copy(copy_l0c_to_ub{}, CopyL0C2UBTraitCustom{});
    auto copy_ub2gm_atom = make_copy(copy_ub_to_gm{}, ub_to_gm_trait_default{});
    auto mmad_atom = make_mmad(mmad_operation{}, mmad_trait_default{});

    // 6. Calculate loop counts and tail tile sizes
    // tile_*: remainder used by the last iteration when the block edge is not divisible by base.
    uint32_t m_loop = (iter_info.actual_single_core_m + base_m - 1) / base_m;
    uint32_t n_loop = (iter_info.actual_single_core_n + base_n - 1) / base_n;
    uint32_t k_loop = (single_core_k + base_k - 1) / base_k;
    uint32_t tile_m = (iter_info.actual_single_core_m % base_m != 0) ? iter_info.actual_single_core_m % base_m : base_m;
    uint32_t tile_n = (iter_info.actual_single_core_n % base_n != 0) ? iter_info.actual_single_core_n % base_n : base_n;
    uint32_t tile_k = (single_core_k % base_k != 0) ? single_core_k % base_k : base_k;

    if ASCEND_IS_AIC {
        // Distinct event ids serializing buffer accesses between pipelines.
        constexpr uint32_t l1_index = 0;
        constexpr uint32_t l0_index = 1;
        constexpr uint32_t l0c_index = 2;
        constexpr uint32_t l1_bias_index = 3;
        constexpr uint32_t l0_bias_index = 4;

        // 7. Main compute loop: (i, j, k_iter) tiles over this core's block;
        // cur_m/cur_n/cur_k are the actual tile sizes (base size, or tail size on the last iteration).
        for (uint32_t i = 0; i < m_loop; i++) {
            uint16_t cur_m = (i + 1 == m_loop) ? tile_m : base_m;
            for (uint32_t j = 0; j < n_loop; j++) {
                mutex<PIPE_MTE2> pipe_mte2_l1_bias_index_mutex(l1_bias_index);
                mutex<PIPE_MTE1> pipe_mte1_l1_bias_index_mutex(l1_bias_index);
                mutex<PIPE_MTE1> pipe_mte1_l0_bias_index_mutex(l0_bias_index);
                mutex<PIPE_FIX> pipe_fix_l0c_index_mutex(l0c_index);
                uint16_t cur_n = (j + 1 == n_loop) ? tile_n : base_n;
                auto l0_c_layout = make_frame_layout<nz_layout_ptn>(cur_m, cur_n);
                auto l0_bias_layout = make_frame_layout<nd_ext_layout_ptn>(1, cur_n);
                auto l0_c_tensor = make_tensor(l0_c_ptr, l0_c_layout);
                auto l0_bias_tensor = make_tensor(l0_bias_ptr, l0_bias_layout);

                // Move bias along the N dimension to L1 and then L0 for the first Mmad of this N tile
                pipe_mte2_l1_bias_index_mutex.lock();
                copy(
                    copy_gm2l1_atom, l1_bias_tensor,
                    global_bias.slice(make_coord(0, j * base_n), make_shape(1, cur_n)));
                pipe_mte2_l1_bias_index_mutex.unlock();
                pipe_mte1_l1_bias_index_mutex.lock();
                pipe_mte1_l0_bias_index_mutex.lock();
                copy(copy_l12bt_atom, l0_bias_tensor, l1_bias_tensor.slice(make_coord(0, 0), make_shape(1, cur_n)));
                pipe_mte1_l0_bias_index_mutex.unlock();
                pipe_mte1_l1_bias_index_mutex.unlock();

                for (uint32_t k_iter = 0; k_iter < k_loop; k_iter++) {
                    mutex<PIPE_MTE1> pipe_mte1_l1_index_mutex(l1_index);
                    mutex<PIPE_MTE1> pipe_mte1_l0_index_mutex(l0_index);
                    mutex<PIPE_M> pipe_m_l0_index_mutex(l0_index);
                    mutex<PIPE_M> pipe_m_l0c_index_mutex(l0c_index);
                    uint16_t cur_k = (k_iter + 1 == k_loop) ? tile_k : base_k;
                    auto l0_a_layout = make_frame_layout<nz_layout_ptn, AType>(cur_m, cur_k);
                    auto l0_b_layout = make_frame_layout<zn_layout_ptn, BType>(cur_k, cur_n);
                    auto l0_a_tensor = make_tensor(l0_a_ptr, l0_a_layout);
                    auto l0_b_tensor = make_tensor(l0_b_ptr, l0_b_layout);

                    // GM -> L1: every step_k iterations prefetch the next step_k base-K slices
                    // (each prefetch fills the K-axis slots [k_iter, k_iter + step_k)).
                    if (k_iter % step_k == 0) {
                        mutex<PIPE_MTE2> pipe_mte2_l1_index_mutex(l1_index);
                        // Clamp the prefetch length to the remaining K of this core (K-axis tail).
                        uint16_t cur_step_k = static_cast<uint16_t>(single_core_k - k_iter * base_k);
                        cur_step_k = cur_step_k < base_k * step_k ? cur_step_k : base_k * step_k;
                        pipe_mte2_l1_index_mutex.lock();
                        copy(
                            copy_gm2l1_atom, l1_a_tensor,
                            global_a.slice(make_coord(i * base_m, k_iter * base_k), make_shape(cur_m, cur_step_k)));
                        copy(
                            copy_gm2l1_atom, l1_b_tensor,
                            global_b.slice(make_coord(k_iter * base_k, j * base_n), make_shape(cur_step_k, cur_n)));
                        pipe_mte2_l1_index_mutex.unlock();
                        // Hold the L1 claim for MTE1 until all step_k slots of this group are consumed.
                        pipe_mte1_l1_index_mutex.lock();
                    }

                    // L1 -> L0: read from the slot k_iter % step_k of the current buffer group.
                    pipe_mte1_l0_index_mutex.lock();
                    copy(
                        copy_l12l0a_atom, l0_a_tensor,
                        l1_a_tensor.slice(make_coord(0, k_iter % step_k * base_k), make_shape(cur_m, cur_k)));
                    copy(
                        copy_l12l0b_atom, l0_b_tensor,
                        l1_b_tensor.slice(make_coord(k_iter % step_k * base_k, 0), make_shape(cur_k, cur_n)));
                    if ((k_iter + 1) % step_k == 0 || k_iter + 1 == k_loop) {
                        pipe_mte1_l1_index_mutex.unlock();
                    }
                    pipe_mte1_l0_index_mutex.unlock();
                    pipe_m_l0_index_mutex.lock();

                    if (k_iter == 0) {
                        pipe_m_l0c_index_mutex.lock();
                    }

                    // Mmad compute
                    if (k_iter == 0) {
                        mutex<PIPE_M> pipe_m_l0_bias_index_mutex(l0_bias_index);
                        pipe_m_l0_bias_index_mutex.lock();
                        mmad(
                            mmad_atom.with(mmad_params(
                                cur_m, cur_n, cur_k,
                                scenario_num == 1 ? ((k_iter == k_loop - 1) ? unit_flag_mode::enable_update :
                                                                              unit_flag_mode::enable_keep) :
                                                    unit_flag_mode::disable,
                                true)),
                            l0_c_tensor, l0_a_tensor, l0_b_tensor, l0_bias_tensor);
                        pipe_m_l0_bias_index_mutex.unlock();
                    } else {
                        mmad(
                            mmad_atom.with(mmad_params(
                                cur_m, cur_n, cur_k,
                                scenario_num == 1 ? ((k_iter == k_loop - 1) ? unit_flag_mode::enable_update :
                                                                              unit_flag_mode::enable_keep) :
                                                    unit_flag_mode::disable,
                                false)),
                            l0_c_tensor, l0_a_tensor, l0_b_tensor);
                    }
                    if (k_iter == k_loop - 1) {
                        pipe_m_l0c_index_mutex.unlock();
                    }
                    pipe_m_l0_index_mutex.unlock();
                }

                pipe_fix_l0c_index_mutex.lock();
                if constexpr (scenario_num < 2) {
                    // L0C -> GM
                    l0c_to_gm_params params;
                    if constexpr (scenario_num == 1) {
                        params.unit_flag = unit_flag_mode::enable_update;
                    }
                    copy(
                        copy_l0c2gm_atom.with(params),
                        global_c.slice(make_coord(i * base_m, j * base_n), make_shape(cur_m, cur_n)), l0_c_tensor);
                } else {
                    // L0C -> UB
                    if constexpr (scenario_num == 2) {
                        // Split along the M dimension
                        copy(
                            copy_l0c2ub_atom,
                            ub_tensor.slice(make_coord(i * base_m / 2, j * base_n), make_shape(cur_m, cur_n)),
                            l0_c_tensor);
                    } else if constexpr (scenario_num == 3) {
                        // Split along the N dimension
                        copy(
                            copy_l0c2ub_atom,
                            ub_tensor.slice(make_coord(i * base_m, j * base_n / 2), make_shape(cur_m, cur_n)),
                            l0_c_tensor);
                    }
                    asc::te::sync_block_arrive(PIPE_FIX, 0x8);
                }
                pipe_fix_l0c_index_mutex.unlock();
            }
        }
    }

    if ASCEND_IS_AIV {
        if constexpr (scenario_num > 1) {
            for (uint32_t i = 0; i < m_loop; i++) {
                uint16_t cur_m = (i + 1 == m_loop) ? tile_m : base_m;
                for (uint32_t j = 0; j < n_loop; j++) {
                    uint16_t cur_n = (j + 1 == n_loop) ? tile_n : base_n;
                    asc::te::sync_block_wait(PIPE_S, 0x8);
                    if constexpr (scenario_num == 2) {
                        // Split along the M dimension
                        copy(
                            copy_ub2gm_atom,
                            global_c.slice(
                                make_coord(i * base_m + get_sub_block_id() * cur_m / 2, j * base_n),
                                make_shape(cur_m / 2, cur_n)),
                            ub_tensor.slice(make_coord(i * base_m / 2, j * base_n), make_shape(cur_m / 2, cur_n)));
                    } else if constexpr (scenario_num == 3) {
                        // Split along the N dimension
                        copy(
                            copy_ub2gm_atom,
                            global_c.slice(
                                make_coord(i * base_m, j * base_n + get_sub_block_id() * cur_n / 2),
                                make_shape(cur_m, cur_n / 2)),
                            ub_tensor.slice(make_coord(i * base_m, j * base_n / 2), make_shape(cur_m, cur_n / 2)));
                    }
                }
            }
        }
    }
    sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    using a_type = half;
    using b_type = half;
    using c_type = float;
    using bias_type = float;

    // Tiling info filled into struct (dynamic at runtime)
    MatmulTiling tiling;
    tiling.m = 1024;
    tiling.n = 1024;
    tiling.k = 256;
    tiling.single_core_m = 256;
    tiling.single_core_n = 128;
    tiling.single_core_k = 256;

    // Static tiling parameters (compile-time constants)
    constexpr int32_t base_m = 128;
    constexpr int32_t base_n = 128;
    constexpr int32_t base_k = 64;
    constexpr int32_t step_m = 1;
    constexpr int32_t step_n = 1;
    constexpr int32_t step_k = 4;

    constexpr uint32_t num_blocks = 32;

    size_t param1_file_size = tiling.m * tiling.k * sizeof(a_type);
    size_t param2_file_size = tiling.n * tiling.k * sizeof(b_type);
    size_t param3_file_size = tiling.m * tiling.n * sizeof(c_type);
    size_t param4_file_size = tiling.n * sizeof(bias_type);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *x_host, *y_host, *z_host, *bias_host;
    a_type* x_device;
    b_type* y_device;
    c_type* z_device;
    bias_type* bias_device;

    aclrtMallocHost((void**)(&x_host), param1_file_size);
    aclrtMallocHost((void**)(&y_host), param2_file_size);
    aclrtMallocHost((void**)(&z_host), param3_file_size);
    aclrtMallocHost((void**)(&bias_host), param4_file_size);
    aclrtMalloc((void**)&x_device, param1_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, param2_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&z_device, param3_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bias_device, param4_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", param1_file_size, x_host, param1_file_size);
    ReadFile("./input/input_y.bin", param2_file_size, y_host, param2_file_size);
    ReadFile("./input/bias.bin", param4_file_size, bias_host, param4_file_size);

    aclrtMemcpy(x_device, param1_file_size, x_host, param1_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(y_device, param2_file_size, y_host, param2_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bias_device, param4_file_size, bias_host, param4_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    // Allocate and copy tiling info struct to device
    MatmulTiling* tiling_host;
    MatmulTiling* tiling_device;
    aclrtMallocHost((void**)(&tiling_host), sizeof(MatmulTiling));
    aclrtMalloc((void**)&tiling_device, sizeof(MatmulTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    *tiling_host = tiling;
    aclrtMemcpy(tiling_device, sizeof(MatmulTiling), tiling_host, sizeof(MatmulTiling), ACL_MEMCPY_HOST_TO_DEVICE);

    copy_out_tensor_api<a_type, b_type, c_type, bias_type, base_m, base_n, base_k, step_m, step_n, step_k>
        <<<num_blocks, 0, stream>>>(x_device, y_device, z_device, bias_device, tiling_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(z_host, param3_file_size, z_device, param3_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", z_host, param3_file_size);

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFree(z_device);
    aclrtFree(bias_device);
    aclrtFree(tiling_device);
    aclrtFreeHost(x_host);
    aclrtFreeHost(y_host);
    aclrtFreeHost(z_host);
    aclrtFreeHost(bias_host);
    aclrtFreeHost(tiling_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return 0;
}
