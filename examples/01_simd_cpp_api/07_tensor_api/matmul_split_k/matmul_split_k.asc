/* !
 * \file matmul_split_k.asc
 * \brief Split-K matmul based on Tensor API with C API atomic accumulation.
 */

#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"

// Split-K matmul: the K dimension is divided into split_k slices, and split_k Cube cores each
// compute one partial product C_slice = A[:, ks:ke] * B[ks:ke, :]; the partial results are summed
// in Global Memory through the Fixpipe atomic-add (no inter-core reduction buffer needed).
constexpr uint32_t m = 16;
constexpr uint32_t k = 1024;
constexpr uint32_t n = 16;
constexpr uint32_t split_k = 4;
constexpr uint32_t base_k = k / split_k;

static_assert(k % split_k == 0, "k must be divisible by split_k");

__global__ __cube__ void matmul_split_k_kernel(__gm__ half* a, __gm__ half* b, __gm__ float* c)
{
    using namespace asc::te;
    init_soc_state();

    // One core per K slice: this core handles the k range [k_offset, k_offset + base_k).
    const uint32_t split_idx = block_idx;
    if (split_idx >= split_k) {
        return;
    }
    const uint32_t k_offset = split_idx * base_k;

    auto gm_a = make_tensor(make_mem_ptr(a), make_frame_layout<nd_ext_layout_ptn>(m, k));
    auto gm_b = make_tensor(make_mem_ptr(b), make_frame_layout<nd_ext_layout_ptn>(k, n));
    auto gm_c = make_tensor(make_mem_ptr(c), make_frame_layout<nd_ext_layout_ptn>(m, n));
    auto a_tile = gm_a.slice(make_coord(0, k_offset), make_shape(m, base_k));
    auto b_tile = gm_b.slice(make_coord(k_offset, 0), make_shape(base_k, n));

    // Layout per level: GM uses nd_ext (linear row-major); L1 A/B, L0A and L0C use the NZ fractal,
    // L0B uses the ZN fractal, matching each buffer's data format for the L1->L0 copies.
    auto l1_a_layout = make_frame_layout<nz_layout_ptn>(m, base_k);
    auto l1_b_layout = make_frame_layout<nz_layout_ptn>(base_k, n);
    auto l0_a_layout = make_frame_layout<nz_layout_ptn>(m, base_k);
    auto l0_b_layout = make_frame_layout<zn_layout_ptn>(base_k, n);
    auto l0_c_layout = make_frame_layout<nz_layout_ptn>(m, n);
    __cbuf__ half l1_a_buf[m * base_k];
    __cbuf__ half l1_b_buf[base_k * n];
    __ca__ half l0_a_buf[m * base_k];
    __cb__ half l0_b_buf[base_k * n];
    __cc__ float l0_c_buf[m * n];

    auto l1_a = make_tensor(make_mem_ptr(l1_a_buf), l1_a_layout);
    auto l1_b = make_tensor(make_mem_ptr(l1_b_buf), l1_b_layout);
    auto l0_a = make_tensor(make_mem_ptr(l0_a_buf), l0_a_layout);
    auto l0_b = make_tensor(make_mem_ptr(l0_b_buf), l0_b_layout);
    auto l0_c = make_tensor(make_mem_ptr(l0_c_buf), l0_c_layout);

    auto gm2l1 = make_copy(copy_gm_to_l1{}, gm_to_l1_trait_default{});
    auto l1tol0a = make_copy(copy_l1_to_l0a{}, l1_to_l0a_trait_default{});
    auto l1tol0b = make_copy(copy_l1_to_l0b{}, l1_to_l0b_trait_default{});
    auto l0c2gm = make_copy(copy_l0c_to_gm{}, l0c_to_gm_trait_default{});
    auto mm = make_mmad(mmad_operation{}, mmad_trait_default{});

    // Event ids serializing buffer accesses between pipelines.
    constexpr uint32_t l1_id = 0;
    mutex<PIPE_MTE2> pipe_mte2_l1_id_mutex(l1_id);
    mutex<PIPE_MTE1> pipe_mte1_l1_id_mutex(l1_id);
    constexpr uint32_t l0_id = 1;
    mutex<PIPE_MTE1> pipe_mte1_l0_id_mutex(l0_id);
    mutex<PIPE_M> pipe_m_l0_id_mutex(l0_id);
    constexpr uint32_t l0c_id = 2;
    mutex<PIPE_M> pipe_m_l0c_id_mutex(l0c_id);
    mutex<PIPE_FIX> pipe_fix_l0c_id_mutex(l0c_id);
    // Lock L0C across the mmad and the atomic copy-out below.
    pipe_m_l0c_id_mutex.lock();
    // MTE2 stage: this core's K slice from GM to L1.
    pipe_mte2_l1_id_mutex.lock();
    copy(gm2l1, l1_a, a_tile);
    copy(gm2l1, l1_b, b_tile);
    pipe_mte2_l1_id_mutex.unlock();
    // MTE1 stage: L1 -> L0.
    pipe_mte1_l1_id_mutex.lock();
    pipe_mte1_l0_id_mutex.lock();
    copy(l1tol0a, l0_a, l1_a);
    copy(l1tol0b, l0_b, l1_b);
    pipe_mte1_l0_id_mutex.unlock();
    pipe_mte1_l1_id_mutex.unlock();
    // M stage: single mmad over this core's whole K slice (init_with_zero = true: fresh C).
    pipe_m_l0_id_mutex.lock();
    auto params = mmad_params{m, n, base_k, unit_flag_mode::disable, true};
    mmad(mm.with(params), l0_c, l0_a, l0_b);
    pipe_m_l0_id_mutex.unlock();
    pipe_m_l0c_id_mutex.unlock();

    // Each Cube core contributes one k slice to the same output matrix.
    // Fixpipe atomic add: the partial results of all split_k cores are summed in GM.
    pipe_fix_l0c_id_mutex.lock();
    asc::te::set_atomic_add<float>();
    copy(l0c2gm, gm_c, l0_c);
    asc::te::disable_dma_atomic();
    pipe_fix_l0c_id_mutex.unlock();
    sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    size_t a_bytes = static_cast<size_t>(m) * k * sizeof(half);
    size_t b_bytes = static_cast<size_t>(k) * n * sizeof(half);
    size_t c_bytes = static_cast<size_t>(m) * n * sizeof(float);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    half* a_host;
    half* a_device;
    aclrtMallocHost((void**)(&a_host), a_bytes);
    aclrtMalloc((void**)&a_device, a_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", a_host, a_bytes);
    aclrtMemcpy(a_device, a_bytes, a_host, a_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    half* b_host;
    half* b_device;
    aclrtMallocHost((void**)(&b_host), b_bytes);
    aclrtMalloc((void**)&b_device, b_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", b_host, b_bytes);
    aclrtMemcpy(b_device, b_bytes, b_host, b_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    float* c_host;
    float* c_device;
    aclrtMallocHost((void**)(&c_host), c_bytes);
    aclrtMalloc((void**)&c_device, c_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    // Atomic accumulation requires the shared output matrix to start at zero.
    aclrtMemset(c_device, c_bytes, 0, c_bytes);

    matmul_split_k_kernel<<<split_k, 0, stream>>>(a_device, b_device, c_device);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(c_host, c_bytes, c_device, c_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", c_host, c_bytes);

    aclrtFree(a_device);
    aclrtFree(b_device);
    aclrtFree(c_device);
    aclrtFreeHost(a_host);
    aclrtFreeHost(b_host);
    aclrtFreeHost(c_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
