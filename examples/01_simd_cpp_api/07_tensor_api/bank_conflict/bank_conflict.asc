/*!
 * \file bank_conflict.asc
 * \brief Tensor API ND-to-NZ bank-conflict sample for Ascend 950PR/Ascend 950DT
 */

#include <cstddef>
#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

namespace {
constexpr uint32_t total_m = 8192;
constexpr uint32_t total_n = 8192;
constexpr uint32_t row_splits = 8;
constexpr uint32_t col_splits = 8;
constexpr uint32_t tile_h = 144;
constexpr uint32_t tile_w = 128;
constexpr uint32_t c0_elems = 16;
constexpr uint32_t tile_c0_cols = tile_w / c0_elems;
constexpr uint32_t total_row_tiles = (total_m + tile_h - 1) / tile_h;
constexpr uint32_t total_col_tiles = total_n / tile_w;
constexpr uint32_t total_blocks = row_splits * col_splits;

// S1 uses the compact NZ stride. S2 adds one DataBlock to the stride between
// C0 blocks so the eight writes in one store land in different bank groups.
constexpr uint32_t bank_conflict_offset = 1;
constexpr bool add_bank_offset = SCENARIO_NUM == 2;
constexpr uint32_t local_column_stride = add_bank_offset ? tile_h + bank_conflict_offset : tile_h;
constexpr uint32_t nd_buffer_elems = tile_h * tile_w;
constexpr uint32_t nz_data_blocks = (tile_c0_cols - 1) * local_column_stride + tile_h;
constexpr uint32_t nz_slot_data_blocks = (nz_data_blocks + 15) / 16 * 16;
constexpr uint32_t nz_slot_elems = nz_slot_data_blocks * c0_elems;

// Keep the optimized member of each pair at bank 8, as in the 3510 reference
// sample. The baseline member starts at bank 0.
constexpr uint32_t nz_base_shift_data_blocks = add_bank_offset ? 8 : 0;
constexpr uint32_t nz_pong_pad_data_blocks = (16 - (nz_slot_data_blocks % 16)) % 16;
constexpr uint32_t nd_ping_offset = 0;
constexpr uint32_t nd_pong_offset = nd_ping_offset + nd_buffer_elems;
constexpr uint32_t nz_ping_offset = nd_pong_offset + nd_buffer_elems + nz_base_shift_data_blocks * c0_elems;
constexpr uint32_t nz_pong_offset = nz_ping_offset + nz_slot_elems + nz_pong_pad_data_blocks * c0_elems;
constexpr uint32_t ub_storage_elems = nz_pong_offset + nz_slot_elems;

static_assert(SCENARIO_NUM >= 1 && SCENARIO_NUM <= 2, "SCENARIO_NUM must be 1 or 2");
static_assert(total_n % tile_w == 0, "total_n must be divisible by tile_w");
static_assert(total_col_tiles % col_splits == 0, "column tiles must be divisible by col_splits");
static_assert(total_row_tiles >= row_splits, "row_splits cannot exceed the number of row tiles");
static_assert(tile_w % c0_elems == 0, "tile_w must be C0 aligned");
} // namespace

template <uint32_t dst_nz_c0_stride>
__simd_vf__ inline void nd_to_nz(__ubuf__ half* dst, __ubuf__ half* src)
{
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    vector_half value;
    asc_loadalign(value, src);
    asc_storealign(dst, value, dst_nz_c0_stride, 0, mask);
}

__global__ __vector__ void bank_conflict_kernel(__gm__ half* x, __gm__ half* z)
{
    asc_init();
    using namespace asc::te;

    const uint32_t block_index = block_idx;
    if (block_index >= total_blocks) {
        return;
    }

    // Split the tiles over blocks: each block handles a row_split x col_split range;
    // the first extra_row_tiles row splits take one extra row tile.
    const uint32_t row_split = block_index / col_splits;
    const uint32_t col_split = block_index % col_splits;
    const uint32_t base_row_tiles = total_row_tiles / row_splits;
    const uint32_t extra_row_tiles = total_row_tiles % row_splits;
    const uint32_t row_tile_begin =
        row_split * base_row_tiles + ((row_split < extra_row_tiles) ? row_split : extra_row_tiles);
    const uint32_t row_tile_count = base_row_tiles + ((row_split < extra_row_tiles) ? 1 : 0);
    const uint32_t col_tiles_per_split = total_col_tiles / col_splits;
    const uint32_t col_tile_begin = col_split * col_tiles_per_split;
    const uint32_t tiles_per_block = row_tile_count * col_tiles_per_split;

    // One UB storage serves two ping-pong slots: each slot holds an ND tile and its NZ-formatted
    // image, so the MTE2/V/MTE3 stages of consecutive tiles can overlap on different slots.
    __ubuf__ half ub_storage[ub_storage_elems];
    auto gm_x_layout = make_frame_layout<nd_layout_ptn, layout_trait_default<half>>(total_m, total_n);
    auto nd_layout = make_frame_layout<nd_layout_ptn, layout_trait_default<half>>(tile_h, tile_w);
    auto gm_x = make_tensor(make_mem_ptr(x), gm_x_layout);
    auto copy_gm_to_ub_atom = make_copy(copy_gm_to_ub{}, gm_to_ub_trait_default{});
    auto copy_ub_to_gm_atom = make_copy(copy_ub_to_gm{}, ub_to_gm_trait_default{});

    for (uint32_t tile_idx = 0; tile_idx < tiles_per_block; ++tile_idx) {
        // Ping-pong slot alternation: even tiles use slot 0, odd tiles slot 1.
        const uint32_t slot = tile_idx & 1;
        const uint32_t tile_row = row_tile_begin + tile_idx / col_tiles_per_split;
        const uint32_t tile_col = col_tile_begin + tile_idx % col_tiles_per_split;
        const uint32_t row_start = tile_row * tile_h;
        const uint32_t col_start = tile_col * tile_w;
        // Tail handling on the row axis: the bottom tiles may be shorter than tile_h.
        const uint32_t remain_rows = total_m - row_start;
        const uint32_t actual_tile_h = remain_rows < tile_h ? remain_rows : tile_h;

        __ubuf__ half* nd_ptr = ub_storage + (slot == 0 ? nd_ping_offset : nd_pong_offset);
        __ubuf__ half* nz_ptr = ub_storage + (slot == 0 ? nz_ping_offset : nz_pong_offset);
        auto nd_tensor = make_tensor(make_mem_ptr(nd_ptr), nd_layout);

        // MTE2 stage: copy one ND tile from GM into this slot's ND buffer.
        asc_lock(PIPE_MTE2, slot);
        copy(
            copy_gm_to_ub_atom, nd_tensor, gm_x, zero_coord, make_coord(row_start, col_start),
            make_shape(actual_tile_h, tile_w));
        asc_unlock(PIPE_MTE2, slot);

        // V stage: reformat the tile from ND to NZ (one loadalign + storealign per row).
        // SCENARIO_NUM selects whether the NZ store stride is padded by bank_conflict_offset
        // to demonstrate the effect of bank conflicts on the store bandwidth.
        asc_lock(PIPE_V, slot);
        auto src_layout =
            make_pattern_layout<nd_layout_ptn, half>(make_shape(tile_h, tile_w), make_stride(tile_w, _1{}));
        auto dst_layout =
            make_pattern_layout<nd_layout_ptn, half>(make_shape(tile_h, c0_elems), make_stride(c0_elems, _1{}));
        auto src_tensor = make_tensor(make_mem_ptr(nd_ptr), src_layout);
        auto dst_tensor = make_tensor(make_mem_ptr(nz_ptr), dst_layout);
        for (uint32_t row = 0; row < actual_tile_h; ++row) {
            auto src_row = src_tensor.slice(make_coord(row, 0), make_shape(1, tile_w));
            auto dst_row = dst_tensor.slice(make_coord(row, 0), make_shape(1, c0_elems));
            if constexpr (SCENARIO_NUM == 1) {
                nd_to_nz<tile_h>(dst_row.data().get(), src_row.data().get());
            } else {
                nd_to_nz<tile_h + bank_conflict_offset>(dst_row.data().get(), src_row.data().get());
            }
        }
        asc_unlock(PIPE_V, slot);

        // Destination offset of this tile in the NZ-formatted output: column blocks are
        // separated by total_m rows; within a column block, rows are contiguous C0 blocks.
        const uint32_t dst_data_block_offset = row_start + (col_start / c0_elems) * total_m;
        auto nz_layout = make_pattern_layout<nd_layout_ptn, half>(
            make_shape(tile_c0_cols, actual_tile_h * c0_elems), make_stride(local_column_stride * c0_elems, _1{}));
        auto gm_z_layout = make_pattern_layout<nd_layout_ptn, half>(
            make_shape(tile_c0_cols, actual_tile_h * c0_elems), make_stride(total_m * c0_elems, _1{}));
        auto nz_tensor = make_tensor(make_mem_ptr(nz_ptr), nz_layout);
        auto gm_z = make_tensor(make_mem_ptr(z + dst_data_block_offset * c0_elems), gm_z_layout);

        // MTE3 stage: copy the NZ-formatted tile back to GM.
        asc_lock(PIPE_MTE3, slot);
        copy(copy_ub_to_gm_atom, gm_z, nz_tensor);
        asc_unlock(PIPE_MTE3, slot);
    }

    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr size_t input_byte_size = static_cast<size_t>(total_m) * total_n * sizeof(half);
    constexpr size_t output_byte_size = static_cast<size_t>(total_m) * total_n * sizeof(half);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    half* x_host = nullptr;
    half* z_host = nullptr;
    half* x_device = nullptr;
    half* z_device = nullptr;
    aclrtMallocHost((void**)(&x_host), input_byte_size);
    aclrtMallocHost((void**)(&z_host), output_byte_size);
    aclrtMalloc((void**)&x_device, input_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&z_device, output_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input.bin", x_host, input_byte_size);
    aclrtMemcpy(x_device, input_byte_size, x_host, input_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    bank_conflict_kernel<<<total_blocks, 0, stream>>>(x_device, z_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(z_host, output_byte_size, z_device, output_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", z_host, output_byte_size);

    aclrtFree(x_device);
    aclrtFree(z_device);
    aclrtFreeHost(x_host);
    aclrtFreeHost(z_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
