/* !
 * \file batch_matmul.asc
 * \brief 本样例介绍基于Tensor API实现带batch的矩阵乘法。
 */

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

template <uint32_t val, uint32_t align>
struct CeilAlign {
    static constexpr uint32_t value = (val + align - 1) / align * align;
};

template <
    typename T, uint32_t batch, uint32_t m, uint32_t k, uint32_t n, uint32_t l1_batch_size, uint32_t l0_batch_size>
__global__ __cube__ void batch_matmul_tensor_api(__gm__ T* a, __gm__ T* b, __gm__ T* c, __gm__ T* bias)
{
    asc_init();
    using namespace asc::te;

    // c0 = 32 / sizeof(T): fractal column size of the element type (NZ format C0).
    // CeilAlign rounds each matrix dimension up to the fractal granularity (16 on the M/N axis,
    // c0 on the K/N axis) so that every buffer size covers whole fractals.
    constexpr uint32_t c0 = 32 / sizeof(T);
    constexpr uint32_t l1_a_size = CeilAlign<m, 16>::value * CeilAlign<k, c0>::value;
    constexpr uint32_t l1_b_size = CeilAlign<k, 16>::value * CeilAlign<n, c0>::value;
    constexpr uint32_t l0_a_size = l1_a_size;
    constexpr uint32_t l0_b_size = CeilAlign<k, c0>::value * CeilAlign<n, 16>::value;
    constexpr uint32_t l0_c_size = CeilAlign<m, 16>::value * CeilAlign<n, 16>::value;

    // Split the Batch dimension over cores: the first single_core_res_b cores each take one extra
    // batch; [b_index_start, b_index_end) is this core's exclusive batch range.
    uint32_t block_index = block_idx;
    uint32_t single_core_b = batch / block_num;
    uint32_t single_core_res_b = batch % block_num;
    uint32_t actual_single_core_b = single_core_b + (single_core_res_b > block_index ? 1 : 0);
    uint32_t b_index_start = single_core_b * block_index + min(block_index, single_core_res_b);
    uint32_t b_index_end = actual_single_core_b + b_index_start;

    // GM tensors carry the outermost Batch dimension: a [batch, m, k], b [batch, k, n],
    // c [batch, m, n], bias [batch, 1, n].
    auto gm_a = make_tensor(make_mem_ptr(a), make_frame_layout<nd_ext_layout_ptn>(batch, m, k));
    auto gm_b = make_tensor(make_mem_ptr(b), make_frame_layout<nd_ext_layout_ptn>(batch, k, n));
    auto gm_c = make_tensor(make_mem_ptr(c), make_frame_layout<nd_ext_layout_ptn>(batch, m, n));
    auto gm_bias = make_tensor(make_mem_ptr(bias), make_frame_layout<nd_ext_layout_ptn>(batch, 1, n));

    // Two-level batching buffers: L1 stages l1_batch_size batches from GM;
    // L0A/L0B/L0C/BiasTable hold l0_batch_size batches for the compute units.
    __cbuf__ T l1_a_buf[l1_batch_size * l1_a_size];
    __cbuf__ T l1_b_buf[l1_batch_size * l1_b_size];
    __cbuf__ T l1_bias_buf[l1_batch_size * n];
    __ca__ T l0_a_buf[l0_batch_size * l0_a_size];
    __cb__ T l0_b_buf[l0_batch_size * l0_b_size];
    __cc__ float l0_c_buf[l0_batch_size * l0_c_size];
    __biasbuf__ float l0_bias_buf[l0_batch_size * n];

    // Layout per level: GM uses nd_ext (linear row-major); L1 A/B, L0A and L0C use the NZ fractal,
    // L0B uses the ZN fractal; bias keeps nd_ext from L1 into the BiasTable buffer.
    auto l1_a_tensor = make_tensor(make_mem_ptr(l1_a_buf), make_frame_layout<nz_layout_ptn, T>(l1_batch_size, m, k));
    auto l1_b_tensor = make_tensor(make_mem_ptr(l1_b_buf), make_frame_layout<nz_layout_ptn, T>(l1_batch_size, k, n));
    auto l1_bias_tensor =
        make_tensor(make_mem_ptr(l1_bias_buf), make_frame_layout<nd_ext_layout_ptn, T>(l1_batch_size, 1, n));
    auto l0_a_tensor = make_tensor(make_mem_ptr(l0_a_buf), make_frame_layout<nz_layout_ptn, T>(l0_batch_size, m, k));
    auto l0_b_tensor = make_tensor(make_mem_ptr(l0_b_buf), make_frame_layout<zn_layout_ptn, T>(l0_batch_size, k, n));
    auto l0_c_tensor = make_tensor(make_mem_ptr(l0_c_buf), make_frame_layout<nz_layout_ptn>(l0_batch_size, m, n));
    auto l0_bias_tensor =
        make_tensor(make_mem_ptr(l0_bias_buf), make_frame_layout<nd_ext_layout_ptn>(l0_batch_size, 1, n));

    auto copy_gm2l1_atom = make_copy(copy_gm_to_l1{}, gm_to_l1_trait_default{});
    auto copy_l12l0a_atom = make_copy(copy_l1_to_l0a{}, l1_to_l0a_trait_default{});
    auto copy_l12l0b_atom = make_copy(copy_l1_to_l0b{}, l1_to_l0b_trait_default{});
    auto copy_l12bt_atom = make_copy(copy_l1_to_biastable{}, l1_to_biastable_trait_default{});
    auto copy_l0c2gm_atom = make_copy(copy_l0c_to_gm{}, l0c_to_gm_trait_default{});
    auto mmad_atom = make_mmad(mmad_operation{}, mmad_trait_default{});

    // Event id serializing the buffer accesses between the pipes.
    static constexpr uint32_t lock_index = 0;
    for (uint32_t l1_batch_index = b_index_start; l1_batch_index < b_index_end; l1_batch_index += l1_batch_size) {
        // MTE2 stage: GM -> L1, staging the A/B/bias tensors of cur_l1_batch_size batches.
        asc_lock(PIPE_MTE2, lock_index);
        // cur_l1_batch_size: batches actually staged in this L1 round (the last round may stage fewer
        // than l1_batch_size batches).
        uint32_t cur_l1_batch_size = min(l1_batch_size, b_index_end - l1_batch_index);
        copy(
            copy_gm2l1_atom, l1_a_tensor,
            gm_a.slice(make_coord(l1_batch_index, make_coord(0, 0)), make_shape(cur_l1_batch_size, make_shape(m, k))));
        copy(
            copy_gm2l1_atom, l1_b_tensor,
            gm_b.slice(make_coord(l1_batch_index, make_coord(0, 0)), make_shape(cur_l1_batch_size, make_shape(k, n))));
        copy(
            copy_gm2l1_atom, l1_bias_tensor,
            gm_bias.slice(
                make_coord(l1_batch_index, make_coord(0, 0)), make_shape(cur_l1_batch_size, make_shape(1, n))));
        asc_unlock(PIPE_MTE2, lock_index);
        for (uint32_t l0_batch_index = 0; l0_batch_index < cur_l1_batch_size; l0_batch_index += l0_batch_size) {
            // MTE1 stage: L1 -> L0A/L0B and L1 -> BiasTable, reading the L1 data staged above.
            asc_lock(PIPE_MTE1, lock_index);
            // cur_l0_batch_size: batches actually loaded into L0 in this round (the last round may load fewer).
            uint32_t cur_l0_batch_size = min(l0_batch_size, cur_l1_batch_size - l0_batch_index);
            copy(
                copy_l12l0a_atom, l0_a_tensor,
                l1_a_tensor.slice(
                    make_coord(l0_batch_index, make_coord(0, 0)), make_shape(cur_l0_batch_size, make_shape(m, k))));
            copy(
                copy_l12l0b_atom, l0_b_tensor,
                l1_b_tensor.slice(
                    make_coord(l0_batch_index, make_coord(0, 0)), make_shape(cur_l0_batch_size, make_shape(k, n))));
            copy(
                copy_l12bt_atom, l0_bias_tensor,
                l1_bias_tensor.slice(
                    make_coord(l0_batch_index, make_coord(0, 0)), make_shape(cur_l0_batch_size, make_shape(1, n))));
            asc_unlock(PIPE_MTE1, lock_index);
            // M stage: one mmad per batch on the L0A/L0B tiles; init_with_zero = true because
            // each batch's C is a fresh output, and the bias is added through the BiasTable input.
            asc_lock(PIPE_M, lock_index);
            for (uint32_t l0_c_batch_index = 0; l0_c_batch_index < cur_l0_batch_size; l0_c_batch_index++) {
                mmad(
                    mmad_atom.with(mmad_params{
                        static_cast<uint16_t>(m), static_cast<uint16_t>(n), static_cast<uint16_t>(k),
                        unit_flag_mode::disable, true}),
                    l0_c_tensor.slice(make_coord(l0_c_batch_index, make_coord(0, 0)), make_shape(1, make_shape(m, n))),
                    l0_a_tensor.slice(make_coord(l0_c_batch_index, make_coord(0, 0)), make_shape(1, make_shape(m, k))),
                    l0_b_tensor.slice(make_coord(l0_c_batch_index, make_coord(0, 0)), make_shape(1, make_shape(k, n))),
                    l0_bias_tensor.slice(
                        make_coord(l0_c_batch_index, make_coord(0, 0)), make_shape(1, make_shape(1, n))));
            }
            // Release the lock so the Fixpipe copy-out below can start.
            asc_unlock(PIPE_M, lock_index);
            // FIX stage: L0C -> GM, copying all cur_l0_batch_size result matrices of
            // this L0 round out at once.
            asc_lock(PIPE_FIX, lock_index);
            copy(
                copy_l0c2gm_atom,
                gm_c.slice(
                    make_coord(l1_batch_index + l0_batch_index, make_coord(0, 0)),
                    make_shape(cur_l0_batch_size, make_shape(m, n))),
                l0_c_tensor);
            asc_unlock(PIPE_FIX, lock_index);
        }
    }
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    using type = half;
    constexpr uint32_t batch = 128;
    constexpr uint32_t m = 32;
    constexpr uint32_t k = 32;
    constexpr uint32_t n = 32;
    constexpr uint32_t l1_batch_size = 32;
    constexpr uint32_t l0_batch_size = 4;

    size_t a_file_size = batch * m * k * sizeof(type);
    size_t b_file_size = batch * k * n * sizeof(type);
    size_t c_file_size = batch * m * n * sizeof(type);
    size_t bias_file_size = batch * 1 * n * sizeof(type);

    uint32_t num_blocks = 32;

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* a_host;
    type* a_device;
    aclrtMallocHost((void**)(&a_host), a_file_size);
    aclrtMalloc((void**)&a_device, a_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", a_file_size, a_host, a_file_size);
    aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* b_host;
    type* b_device;
    aclrtMallocHost((void**)(&b_host), b_file_size);
    aclrtMalloc((void**)&b_device, b_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", b_file_size, b_host, b_file_size);
    aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bias_host;
    type* bias_device;
    aclrtMallocHost((void**)(&bias_host), bias_file_size);
    aclrtMalloc((void**)&bias_device, bias_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/bias.bin", bias_file_size, bias_host, bias_file_size);
    aclrtMemcpy(bias_device, bias_file_size, bias_host, bias_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* c_host;
    type* c_device;
    aclrtMallocHost((void**)(&c_host), c_file_size);
    aclrtMalloc((void**)&c_device, c_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    batch_matmul_tensor_api<type, batch, m, k, n, l1_batch_size, l0_batch_size>
        <<<num_blocks, 0, stream>>>(a_device, b_device, c_device, bias_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", c_host, c_file_size);

    aclrtFree(a_device);
    aclrtFreeHost(a_host);
    aclrtFree(b_device);
    aclrtFreeHost(b_host);
    aclrtFree(c_device);
    aclrtFreeHost(c_host);
    aclrtFree(bias_device);
    aclrtFreeHost(bias_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
