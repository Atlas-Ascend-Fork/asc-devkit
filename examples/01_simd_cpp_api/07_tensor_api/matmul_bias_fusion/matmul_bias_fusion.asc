/*!
 * \file matmul_bias_fusion.asc
 * \brief Cube matmul with bias fused with Vector residual addition.
 */

#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "c_api/sync/sync.h"
#include "data_utils.h"
#include "tensor_api/experimental/vector_ops.h"
#include "tensor_api/tensor.h"

struct MatmulTiling {
    int32_t m;
    int32_t n;
    int32_t k;
    int32_t single_core_m;
    int32_t single_core_n;
    int32_t single_core_k;
};

struct CoreIterInfo {
    uint32_t m_iter;
    uint32_t m_iter_idx;
    uint32_t n_iter_idx;
    int32_t actual_single_core_m;
    int32_t actual_single_core_n;
};

constexpr uint32_t matrix_m = 1024;
constexpr uint32_t matrix_n = 1024;
constexpr uint32_t matrix_k = 256;
constexpr uint32_t single_core_m = 256;
constexpr uint32_t single_core_n = 128;
constexpr uint32_t base_m = 128;
constexpr uint32_t base_n = 128;
constexpr uint32_t base_k = 64;
constexpr uint32_t step_m = 1;
constexpr uint32_t step_n = 1;
constexpr uint32_t step_k = 4;
constexpr uint32_t vector_len = base_n < 64 ? base_n : 64;
constexpr uint32_t pipe_depth = 2;
constexpr int64_t aic_to_aiv_flags[pipe_depth] = {8, 9};
constexpr int64_t aiv_to_aic_flags[pipe_depth] = {10, 11};

static_assert(matrix_m % single_core_m == 0, "M must be evenly distributed across Cube cores");
static_assert(single_core_m % base_m == 0, "single_core_m must contain complete Cube tiles");
static_assert(base_m % 2 == 0, "dual-destination split_m requires an even tile M");

constexpr asc::te::l0c_to_ub_trait copy_l0c2ub_trait = {
    asc::te::round_mode::default_round, false, false, asc::te::dual_dst_mode::split_m};
struct CopyL0C2UBTraitCustom {
    using TraitType = asc::te::l0c_to_ub_trait;
    static constexpr const TraitType value = copy_l0c2ub_trait;
};

__aicore__ inline void copy_tiling_from_gm(__gm__ MatmulTiling* src_info, MatmulTiling& dst_info)
{
    auto src_ptr = reinterpret_cast<__gm__ int32_t*>(src_info);
    auto dst_ptr = reinterpret_cast<int32_t*>(&dst_info);
    for (size_t i = 0; i < sizeof(MatmulTiling) / sizeof(int32_t); ++i) {
        dst_ptr[i] = src_ptr[i];
    }
}

__aicore__ inline CoreIterInfo calc_core_iter_info(const MatmulTiling& tiling)
{
    const uint32_t m_iter = (tiling.m + tiling.single_core_m - 1) / tiling.single_core_m;
    const uint32_t m_iter_idx = block_idx % m_iter;
    const uint32_t n_iter_idx = block_idx / m_iter;
    int32_t actual_single_core_m = tiling.m - m_iter_idx * tiling.single_core_m;
    actual_single_core_m = actual_single_core_m < tiling.single_core_m ? actual_single_core_m : tiling.single_core_m;
    int32_t actual_single_core_n = tiling.n - n_iter_idx * tiling.single_core_n;
    actual_single_core_n = actual_single_core_n < tiling.single_core_n ? actual_single_core_n : tiling.single_core_n;
    return {m_iter, m_iter_idx, n_iter_idx, actual_single_core_m, actual_single_core_n};
}

template <typename Src0Tensor, typename Src1Tensor, typename DstTensor>
__simd_vf__ inline void compute_add(Src0Tensor src0, Src1Tensor src1, DstTensor dst, uint32_t length)
{
    using namespace asc::te;
    const auto coord = make_coord(0);
    auto mask = experimental::update_mask<float>(length);
    auto lhs = experimental::load(src0, coord).with_mask(mask);
    auto rhs = experimental::load(src1, coord).with_mask(mask);
    experimental::store(dst, coord, lhs + rhs);
}

template <typename AType, typename BType, typename CType, typename BiasType>
__global__ __mix__(1, 2) void matmul_bias_fusion(
    __gm__ AType* a, __gm__ BType* b, __gm__ BiasType* bias, __gm__ CType* residual, __gm__ CType* y,
    __gm__ MatmulTiling* tiling_info)
{
    using namespace asc::te;
    init_soc_state();

    // Runtime tiling from GM; iter_info maps block_idx to this core's output tile
    // (m_iter_idx fastest over the m-axis splits; the last block on each axis may be smaller).
    MatmulTiling tiling;
    copy_tiling_from_gm(tiling_info, tiling);
    const CoreIterInfo iter_info = calc_core_iter_info(tiling);

    auto gm_a = make_tensor(make_mem_ptr(a), make_frame_layout<nd_ext_layout_ptn>(tiling.m, tiling.k));
    auto gm_b = make_tensor(make_mem_ptr(b), make_frame_layout<nd_ext_layout_ptn>(tiling.k, tiling.n));
    auto gm_bias = make_tensor(make_mem_ptr(bias), make_frame_layout<nd_ext_layout_ptn>(1, tiling.n));
    auto gm_residual = make_tensor(make_mem_ptr(residual), make_frame_layout<nd_ext_layout_ptn>(tiling.m, tiling.n));
    auto gm_y = make_tensor(make_mem_ptr(y), make_frame_layout<nd_ext_layout_ptn>(tiling.m, tiling.n));

    auto global_a = gm_a.slice(
        make_coord(iter_info.m_iter_idx * tiling.single_core_m, 0),
        make_shape(iter_info.actual_single_core_m, tiling.single_core_k));
    auto global_b = gm_b.slice(
        make_coord(0, iter_info.n_iter_idx * tiling.single_core_n),
        make_shape(tiling.single_core_k, iter_info.actual_single_core_n));
    auto global_bias = gm_bias.slice(
        make_coord(0, iter_info.n_iter_idx * tiling.single_core_n), make_shape(1, iter_info.actual_single_core_n));

    // Loop counts for the (i, j, k_iter) tiling of this core's block.
    const uint32_t m_loop = (iter_info.actual_single_core_m + base_m - 1) / base_m;
    const uint32_t n_loop = (iter_info.actual_single_core_n + base_n - 1) / base_n;
    const uint32_t k_loop = (tiling.single_core_k + base_k - 1) / base_k;
    const uint32_t tile_m =
        (iter_info.actual_single_core_m % base_m != 0) ? iter_info.actual_single_core_m % base_m : base_m;
    const uint32_t tile_n =
        (iter_info.actual_single_core_n % base_n != 0) ? iter_info.actual_single_core_n % base_n : base_n;
    const uint32_t tile_k = (tiling.single_core_k % base_k != 0) ? tiling.single_core_k % base_k : base_k;

    // The split-m copy writes half of each tile into the local UB of each AIV.
    // Two fixed regions are used so Cube can hand off the next tile while Vector consumes the previous one.
    __ubuf__ CType ub_buf[pipe_depth * base_m * base_n / 2];
    auto ub_tensor =
        make_tensor(make_mem_ptr(ub_buf), make_frame_layout<nd_ext_layout_ptn>(pipe_depth * base_m, base_n));

    // Cube side (AIC): matmul with bias, result handed to UB through the split-m dual_dst_mode
    // Fixpipe copy; Vector side (AIV) below adds the residual and writes GM.
    if ASCEND_IS_AIC {
        // Event ids serializing buffer accesses between pipelines.
        constexpr uint32_t l1_index = 0;
        constexpr uint32_t l0_index = 1;
        constexpr uint32_t l0c_index = 2;
        constexpr uint32_t l1_bias_index = 3;
        constexpr uint32_t l0_bias_index = 4;

        __cbuf__ AType l1_a_buf[base_m * step_m * base_k * step_k];
        __cbuf__ BType l1_b_buf[base_k * step_k * base_n * step_n];
        __cbuf__ BiasType l1_bias_buf[base_n * step_n];
        __ca__ AType l0_a_buf[base_m * base_k];
        __cb__ BType l0_b_buf[base_k * base_n];
        __biasbuf__ BiasType l0_bias_buf[base_n];
        __cc__ CType l0_c_buf[base_m * base_n];

        auto l1_a = make_tensor(
            make_mem_ptr(l1_a_buf), make_frame_layout<nz_layout_ptn, AType>(base_m * step_m, base_k * step_k));
        auto l1_b = make_tensor(
            make_mem_ptr(l1_b_buf), make_frame_layout<nz_layout_ptn, BType>(base_k * step_k, base_n * step_n));
        auto l1_bias = make_tensor(make_mem_ptr(l1_bias_buf), make_frame_layout<nd_ext_layout_ptn>(1, base_n * step_n));
        auto l0_a_ptr = make_mem_ptr(l0_a_buf);
        auto l0_b_ptr = make_mem_ptr(l0_b_buf);
        auto l0_bias_ptr = make_mem_ptr(l0_bias_buf);
        auto l0_c_ptr = make_mem_ptr(l0_c_buf);
        auto gm2l1 = make_copy(copy_gm_to_l1{}, gm_to_l1_trait_default{});
        auto l1tol0a = make_copy(copy_l1_to_l0a{}, l1_to_l0a_trait_default{});
        auto l1tol0b = make_copy(copy_l1_to_l0b{}, l1_to_l0b_trait_default{});
        auto l1tobt = make_copy(copy_l1_to_biastable{}, l1_to_biastable_trait_default{});
        auto l0c2ub = make_copy(copy_l0c_to_ub{}, CopyL0C2UBTraitCustom{});
        auto mm = make_mmad(mmad_operation{}, mmad_trait_default{});

        // Main compute loop: (i, j, k_iter) tiles over this core's block;
        // cur_m/cur_n/cur_k are the actual tile sizes (base or tail on the last iteration).
        // Each output tile uses UB slot = sequence % pipe_depth (two fixed regions alternating across tiles).
        for (uint32_t i = 0; i < m_loop; ++i) {
            const uint16_t cur_m = (i + 1 == m_loop) ? tile_m : base_m;
            for (uint32_t j = 0; j < n_loop; ++j) {
                mutex<PIPE_MTE2> pipe_mte2_l1_bias_index_mutex(l1_bias_index);
                mutex<PIPE_MTE1> pipe_mte1_l1_bias_index_mutex(l1_bias_index);
                mutex<PIPE_MTE1> pipe_mte1_l0_bias_index_mutex(l0_bias_index);
                mutex<PIPE_FIX> pipe_fix_l0c_index_mutex(l0c_index);
                const uint16_t cur_n = (j + 1 == n_loop) ? tile_n : base_n;
                const uint32_t sequence = i * n_loop + j;
                const uint32_t slot = sequence % pipe_depth;
                if (sequence >= pipe_depth) {
                    asc::te::sync_block_wait(PIPE_MTE2, aiv_to_aic_flags[slot]);
                }

                auto l0_c = make_tensor(l0_c_ptr, make_frame_layout<nz_layout_ptn>(cur_m, cur_n));
                auto l0_bias = make_tensor(l0_bias_ptr, make_frame_layout<nd_ext_layout_ptn>(1, cur_n));

                pipe_mte2_l1_bias_index_mutex.lock();
                copy(gm2l1, l1_bias, global_bias.slice(make_coord(0, j * base_n), make_shape(1, cur_n)));
                pipe_mte2_l1_bias_index_mutex.unlock();
                pipe_mte1_l1_bias_index_mutex.lock();
                pipe_mte1_l0_bias_index_mutex.lock();
                copy(l1tobt, l0_bias, l1_bias.slice(make_coord(0, 0), make_shape(1, cur_n)));
                pipe_mte1_l0_bias_index_mutex.unlock();
                pipe_mte1_l1_bias_index_mutex.unlock();

                // L1 prefetch runs step_k base-K slices ahead of consumption
                // (slot index = k_iter % step_k, released when the group is fully consumed).
                for (uint32_t k_iter = 0; k_iter < k_loop; ++k_iter) {
                    mutex<PIPE_MTE1> pipe_mte1_l1_index_mutex(l1_index);
                    mutex<PIPE_MTE1> pipe_mte1_l0_index_mutex(l0_index);
                    mutex<PIPE_M> pipe_m_l0_index_mutex(l0_index);
                    mutex<PIPE_M> pipe_m_l0c_index_mutex(l0c_index);
                    const uint16_t cur_k = (k_iter + 1 == k_loop) ? tile_k : base_k;
                    auto l0_a = make_tensor(l0_a_ptr, make_frame_layout<nz_layout_ptn, AType>(cur_m, cur_k));
                    auto l0_b = make_tensor(l0_b_ptr, make_frame_layout<zn_layout_ptn, BType>(cur_k, cur_n));

                    if (k_iter % step_k == 0) {
                        mutex<PIPE_MTE2> pipe_mte2_l1_index_mutex(l1_index);
                        uint16_t cur_step_k = static_cast<uint16_t>(tiling.single_core_k - k_iter * base_k);
                        cur_step_k = cur_step_k < base_k * step_k ? cur_step_k : base_k * step_k;
                        pipe_mte2_l1_index_mutex.lock();
                        copy(
                            gm2l1, l1_a,
                            global_a.slice(make_coord(i * base_m, k_iter * base_k), make_shape(cur_m, cur_step_k)));
                        copy(
                            gm2l1, l1_b,
                            global_b.slice(make_coord(k_iter * base_k, j * base_n), make_shape(cur_step_k, cur_n)));
                        pipe_mte2_l1_index_mutex.unlock();
                        pipe_mte1_l1_index_mutex.lock();
                    }

                    pipe_mte1_l0_index_mutex.lock();
                    copy(l1tol0a, l0_a, l1_a.slice(make_coord(0, k_iter % step_k * base_k), make_shape(cur_m, cur_k)));
                    copy(l1tol0b, l0_b, l1_b.slice(make_coord(k_iter % step_k * base_k, 0), make_shape(cur_k, cur_n)));
                    if ((k_iter + 1) % step_k == 0 || k_iter + 1 == k_loop) {
                        pipe_mte1_l1_index_mutex.unlock();
                    }
                    pipe_mte1_l0_index_mutex.unlock();
                    pipe_m_l0_index_mutex.lock();
                    if (k_iter == 0) {
                        mutex<PIPE_M> pipe_m_l0_bias_index_mutex(l0_bias_index);
                        pipe_m_l0c_index_mutex.lock();
                        pipe_m_l0_bias_index_mutex.lock();
                        mmad(
                            mm.with(mmad_params(cur_m, cur_n, cur_k, unit_flag_mode::disable, true)), l0_c, l0_a, l0_b,
                            l0_bias);
                        pipe_m_l0_bias_index_mutex.unlock();
                    } else {
                        mmad(
                            mm.with(mmad_params(cur_m, cur_n, cur_k, unit_flag_mode::disable, false)), l0_c, l0_a,
                            l0_b);
                    }
                    if (k_iter == k_loop - 1) {
                        pipe_m_l0c_index_mutex.unlock();
                    }
                    pipe_m_l0_index_mutex.unlock();
                }

                // FIX stage: split-m dual_dst_mode copy writes this tile's half rows into the
                // local UB of both AIV sub-blocks, then signals the Vector side (per-slot flag).
                pipe_fix_l0c_index_mutex.lock();
                copy(l0c2ub, ub_tensor.slice(make_coord(slot * base_m / 2, 0), make_shape(cur_m, cur_n)), l0_c);
                asc::te::sync_block_arrive(PIPE_FIX, aic_to_aiv_flags[slot]);
                pipe_fix_l0c_index_mutex.unlock();
            }
        }
        // Wait until the AIV side has consumed the last pipe_depth outstanding tiles.
        const uint32_t tile_count = m_loop * n_loop;
        const uint32_t first_outstanding = tile_count > pipe_depth ? tile_count - pipe_depth : 0;
        for (uint32_t sequence = first_outstanding; sequence < tile_count; ++sequence) {
            asc::te::sync_block_wait(PIPE_MTE2, aiv_to_aic_flags[sequence % pipe_depth]);
        }
    }

    // Vector side (AIV): per output tile, load the matmul result from the local UB slot,
    // add the residual from GM and write the sum to GM (element-wise add on registers).
    if ASCEND_IS_AIV {
        __ubuf__ CType value_buf[vector_len];
        __ubuf__ CType residual_buf[vector_len];
        __ubuf__ CType output_buf[vector_len];
        auto vector_layout = make_layout(make_shape(vector_len));
        auto copy_layout = make_frame_layout<nd_ext_layout_ptn>(1, vector_len);
        auto value_vec = make_tensor(make_mem_ptr(value_buf), vector_layout);
        auto residual_vec = make_tensor(make_mem_ptr(residual_buf), vector_layout);
        auto output_vec = make_tensor(make_mem_ptr(output_buf), vector_layout);
        auto value_copy = make_tensor(make_mem_ptr(value_buf), copy_layout);
        auto residual_copy = make_tensor(make_mem_ptr(residual_buf), copy_layout);
        auto output_copy = make_tensor(make_mem_ptr(output_buf), copy_layout);
        auto ub2ub = make_copy(copy_ub_to_ub{}, ub_to_ub_trait_default{});
        auto gm2ub = make_copy(copy_gm_to_ub{});
        auto ub2gm = make_copy(copy_ub_to_gm{});
        const uint32_t sub_block_id = static_cast<uint32_t>(get_sub_block_id());

        for (uint32_t i = 0; i < m_loop; ++i) {
            const uint16_t cur_m = (i + 1 == m_loop) ? tile_m : base_m;
            const uint16_t half_m = cur_m / 2;
            for (uint32_t j = 0; j < n_loop; ++j) {
                const uint16_t cur_n = (j + 1 == n_loop) ? tile_n : base_n;
                const uint32_t sequence = i * n_loop + j;
                const uint32_t slot = sequence % pipe_depth;
                asc::te::sync_block_wait(PIPE_S, aic_to_aiv_flags[slot]);
                for (uint32_t row = 0; row < half_m; ++row) {
                    const uint32_t global_row =
                        iter_info.m_iter_idx * tiling.single_core_m + i * base_m + sub_block_id * half_m + row;
                    for (uint32_t column = 0; column < cur_n; column += vector_len) {
                        mutex<PIPE_MTE2> pipe_mte2_0_mutex(0);
                        mutex<PIPE_V> pipe_v_0_mutex(0);
                        mutex<PIPE_MTE3> pipe_mte3_0_mutex(0);
                        const uint32_t length = cur_n - column < vector_len ? cur_n - column : vector_len;
                        auto ub_part =
                            ub_tensor.slice(make_coord(slot * base_m / 2 + row, column), make_shape(1, length));
                        auto residual_part = gm_residual.slice(
                            make_coord(global_row, iter_info.n_iter_idx * tiling.single_core_n + j * base_n + column),
                            make_shape(1, length));
                        auto output_part = gm_y.slice(
                            make_coord(global_row, iter_info.n_iter_idx * tiling.single_core_n + j * base_n + column),
                            make_shape(1, length));
                        pipe_mte2_0_mutex.lock();
                        copy(ub2ub, value_copy.slice(make_coord(0, 0), make_shape(1, length)), ub_part);
                        copy(gm2ub, residual_copy.slice(make_coord(0, 0), make_shape(1, length)), residual_part);
                        pipe_mte2_0_mutex.unlock();
                        pipe_v_0_mutex.lock();
                        compute_add(value_vec, residual_vec, output_vec, length);
                        pipe_v_0_mutex.unlock();
                        pipe_mte3_0_mutex.lock();
                        copy(ub2gm, output_part, output_copy.slice(make_coord(0, 0), make_shape(1, length)));
                        pipe_mte3_0_mutex.unlock();
                    }
                }
                asc::te::sync_block_arrive(PIPE_MTE3, aiv_to_aic_flags[slot]);
            }
        }
    }
    sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    using a_type = half;
    using b_type = half;
    using c_type = float;
    using bias_type = float;

    MatmulTiling tiling;
    tiling.m = matrix_m;
    tiling.n = matrix_n;
    tiling.k = matrix_k;
    tiling.single_core_m = single_core_m;
    tiling.single_core_n = single_core_n;
    tiling.single_core_k = matrix_k;

    const uint32_t m_blocks = (tiling.m + tiling.single_core_m - 1) / tiling.single_core_m;
    const uint32_t n_blocks = (tiling.n + tiling.single_core_n - 1) / tiling.single_core_n;
    const uint32_t num_blocks = m_blocks * n_blocks;

    size_t a_file_size = tiling.m * tiling.k * sizeof(a_type);
    size_t b_file_size = tiling.k * tiling.n * sizeof(b_type);
    size_t bias_file_size = tiling.n * sizeof(bias_type);
    size_t matrix_file_size = tiling.m * tiling.n * sizeof(c_type);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *a_host, *b_host, *bias_host, *residual_host, *y_host;
    a_type* a_device;
    b_type* b_device;
    bias_type* bias_device;
    c_type* residual_device;
    c_type* y_device;

    aclrtMallocHost((void**)(&a_host), a_file_size);
    aclrtMallocHost((void**)(&b_host), b_file_size);
    aclrtMallocHost((void**)(&bias_host), bias_file_size);
    aclrtMallocHost((void**)(&residual_host), matrix_file_size);
    aclrtMallocHost((void**)(&y_host), matrix_file_size);
    aclrtMalloc((void**)&a_device, a_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&b_device, b_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bias_device, bias_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&residual_device, matrix_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, matrix_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/a.bin", a_host, a_file_size);
    ReadFile("./input/b.bin", b_host, b_file_size);
    ReadFile("./input/bias.bin", bias_host, bias_file_size);
    ReadFile("./input/residual.bin", residual_host, matrix_file_size);

    aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bias_device, bias_file_size, bias_host, bias_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(residual_device, matrix_file_size, residual_host, matrix_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    MatmulTiling* tiling_host;
    MatmulTiling* tiling_device;
    aclrtMallocHost((void**)(&tiling_host), sizeof(MatmulTiling));
    aclrtMalloc((void**)&tiling_device, sizeof(MatmulTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    *tiling_host = tiling;
    aclrtMemcpy(tiling_device, sizeof(MatmulTiling), tiling_host, sizeof(MatmulTiling), ACL_MEMCPY_HOST_TO_DEVICE);

    matmul_bias_fusion<a_type, b_type, c_type, bias_type>
        <<<num_blocks, 0, stream>>>(a_device, b_device, bias_device, residual_device, y_device, tiling_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(y_host, matrix_file_size, y_device, matrix_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", y_host, matrix_file_size);

    aclrtFree(a_device);
    aclrtFree(b_device);
    aclrtFree(bias_device);
    aclrtFree(residual_device);
    aclrtFree(y_device);
    aclrtFree(tiling_device);
    aclrtFreeHost(a_host);
    aclrtFreeHost(b_host);
    aclrtFreeHost(bias_host);
    aclrtFreeHost(residual_host);
    aclrtFreeHost(y_host);
    aclrtFreeHost(tiling_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return 0;
}
