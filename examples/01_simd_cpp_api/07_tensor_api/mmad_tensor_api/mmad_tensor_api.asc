/* !
 * \file mmad_tensor_api.asc
 * \brief
 */
#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

template <
    typename AType, typename BType, typename L0CType, typename CType, int32_t base_m, int32_t base_n, int32_t base_k,
    int32_t step_m, int32_t step_n, int32_t step_k, bool enable_unitflag>
__cube__ __global__ void mmad_quant_custom(
    __gm__ AType* x, __gm__ BType* y, __gm__ CType* z, __gm__ uint64_t* quant, int32_t m, int32_t n, int32_t k,
    int32_t single_core_m, int32_t single_core_n, int32_t single_core_k)
{
    using namespace asc::te;
    init_soc_state();
    // Map block_idx to this core's output tile: m_iter_idx iterates fastest over the m-axis splits.
    uint32_t m_iter = (m + single_core_m - 1) / single_core_m;
    uint32_t m_iter_idx = block_idx % m_iter;
    uint32_t n_iter_idx = block_idx / m_iter;
    // Actual per-core tile size at the block edge (the last block on each axis may be smaller when M/N is not divisible
    // by single_core_m/n).
    int32_t actual_single_core_m = m - m_iter_idx * single_core_m;
    int32_t actual_single_core_n = n - n_iter_idx * single_core_n;
    actual_single_core_m = actual_single_core_m < single_core_m ? actual_single_core_m : single_core_m;
    actual_single_core_n = actual_single_core_n < single_core_n ? actual_single_core_n : single_core_n;

    // GM tensors: A in ND layout (row-major [m, k]); B in DN layout (stored transposed [n, k] in input files);
    // C in ND layout; quant holds the per-channel scale factors of shape [1, n].
    auto gm_a_tensor = make_tensor(make_mem_ptr(x), make_frame_layout<nd_ext_layout_ptn>(m, k));
    auto gm_b_tensor = make_tensor(make_mem_ptr(y), make_frame_layout<dn_ext_layout_ptn>(k, n));
    auto gm_c_tensor = make_tensor(make_mem_ptr(z), make_frame_layout<nd_ext_layout_ptn>(m, n));
    auto gm_quant_tensor = make_tensor(make_mem_ptr(quant), make_frame_layout<nd_ext_layout_ptn>(1, n));

    // Slice this core's sub-matrices from the full GM tensors, anchored at
    // (m_iter_idx * single_core_m, n_iter_idx * single_core_n).
    auto gm_a_single_tensor =
        gm_a_tensor.slice(make_coord(m_iter_idx * single_core_m, 0), make_shape(actual_single_core_m, single_core_k));
    auto gm_b_single_tensor =
        gm_b_tensor.slice(make_coord(0, n_iter_idx * single_core_n), make_shape(single_core_k, actual_single_core_n));
    auto gm_c_single_tensor = gm_c_tensor.slice(
        make_coord(m_iter_idx * single_core_m, n_iter_idx * single_core_n),
        make_shape(actual_single_core_m, actual_single_core_n));
    auto gm_quant_single_tensor =
        gm_quant_tensor.slice(make_coord(0, n_iter_idx * single_core_n), make_shape(1, actual_single_core_n));

    // Multi-level buffer allocation:
    // - L1 holds step_m*step_k A-tiles and step_k*step_n B-tiles: the K axis is split into step_k slots
    //   so GM->L1 prefetch can run ahead of L1->L0 consumption (slot index = k_iter % step_k).
    // - L0A/L0B hold one base tile for the current mmad; L0C holds one output tile.
    // - L1 quant buffer holds the per-channel scales of one base_n columns.
    __cbuf__ AType l1_a_buf[base_m * step_m * base_k * step_k];
    __cbuf__ BType l1_b_buf[base_k * step_k * base_n * step_n];
    __cbuf__ uint64_t l1_quant_buf[base_n * step_n];
    __ca__ AType l0_a_buf[base_m * base_k];
    __cb__ BType l0_b_buf[base_k * base_n];
    __cc__ L0CType l0_c_buf[base_m * base_n];

    auto l1_quant_ptr = make_mem_ptr(l1_quant_buf);
    auto l0_a_ptr = make_mem_ptr(l0_a_buf);
    auto l0_b_ptr = make_mem_ptr(l0_b_buf);
    auto l0_c_ptr = make_mem_ptr(l0_c_buf);

    auto copy_gm2l1_atom = make_copy(copy_gm_to_l1{}, gm_to_l1_trait_default{});
    auto copy_l12l0a_atom = make_copy(copy_l1_to_l0a{}, l1_to_l0a_trait_default{});
    auto copy_l12l0b_atom = make_copy(copy_l1_to_l0b{}, l1_to_l0b_trait_default{});
    auto copy_l0c2gm_atom = make_copy(copy_l0c_to_gm{}, l0c_to_gm_trait_default{});
    auto mmad_atom = make_mmad(mmad_operation{}, mmad_trait_default{});

    // L1 tensors use the same fractal layout as their L0 destination (NZ for A -> L0A, ZN for B -> L0B),
    // matching the input fractal format required by mmad.
    auto l1_a_tensor =
        make_tensor(make_mem_ptr(l1_a_buf), make_frame_layout<nz_layout_ptn, AType>(base_m * step_m, base_k * step_k));
    auto l1_b_tensor =
        make_tensor(make_mem_ptr(l1_b_buf), make_frame_layout<zn_layout_ptn, BType>(base_k * step_k, base_n * step_n));

    // Number of base-tile iterations covering this core's block on each axis.
    uint32_t m_loop = (actual_single_core_m + base_m - 1) / base_m;
    uint32_t n_loop = (actual_single_core_n + base_n - 1) / base_n;
    uint32_t k_loop = (single_core_k + base_k - 1) / base_k;

    // Distinct event ids used to serialize accesses on the L1/L0/L0C/quant buffers between pipelines.
    static constexpr uint32_t l1_index = 0;
    static constexpr uint32_t l0_index = 1;
    static constexpr uint32_t l0c_index = 2;
    static constexpr uint32_t quant_index = 3;
    // The last iteration of each axis uses the remainder (actual % base) when not divisible by base.
    uint16_t tile_m = (actual_single_core_m % base_m != 0) ? actual_single_core_m % base_m : base_m;
    uint16_t tile_n = (actual_single_core_n % base_n != 0) ? actual_single_core_n % base_n : base_n;
    uint16_t tile_k = (single_core_k % base_k != 0) ? single_core_k % base_k : base_k;

    for (uint32_t i = 0; i < m_loop; i++) {
        // cur_m/cur_n/cur_k: actual size of the current tile (base size, or the remainder on the last iteration).
        uint16_t cur_m = (i + 1 == m_loop) ? tile_m : base_m;
        for (uint32_t j = 0; j < n_loop; j++) {
            mutex<PIPE_MTE2> pipe_mte2_quant_index_mutex(quant_index);
            mutex<PIPE_FIX> pipe_fix_quant_index_mutex(quant_index);
            mutex<PIPE_FIX> pipe_fix_l0c_index_mutex(l0c_index);
            uint16_t cur_n = (j + 1 == n_loop) ? tile_n : base_n;
            // One L0C tile per (i, j) output tile, accumulated over the k loop below.
            auto l0_c_tensor = make_tensor(l0_c_ptr, make_frame_layout<nz_layout_ptn>(cur_m, cur_n));
            for (uint32_t k_iter = 0; k_iter < k_loop; k_iter++) {
                mutex<PIPE_MTE1> pipe_mte1_l1_index_mutex(l1_index);
                mutex<PIPE_MTE1> pipe_mte1_l0_index_mutex(l0_index);
                mutex<PIPE_M> pipe_m_l0_index_mutex(l0_index);
                mutex<PIPE_M> pipe_m_l0c_index_mutex(l0c_index);
                uint16_t cur_k = (k_iter + 1 == k_loop) ? tile_k : base_k;
                auto l0_a_tensor = make_tensor(l0_a_ptr, make_frame_layout<nz_layout_ptn, AType>(cur_m, cur_k));
                auto l0_b_tensor = make_tensor(l0_b_ptr, make_frame_layout<zn_layout_ptn, BType>(cur_k, cur_n));
                // Every step_k iterations, prefetch the next step_k base-K slices from GM into L1
                // (each prefetch fills the K-axis slots [k_iter, k_iter + step_k)).
                if (k_iter % step_k == 0) {
                    mutex<PIPE_MTE2> pipe_mte2_l1_index_mutex(l1_index);
                    // Clamp the prefetch length to the remaining K of this core (the remaining K may be less than one
                    // full group).
                    uint16_t cur_step_k = static_cast<uint16_t>(single_core_k - k_iter * base_k);
                    cur_step_k = cur_step_k < base_k * step_k ? cur_step_k : base_k * step_k;
                    pipe_mte2_l1_index_mutex.lock();
                    // GM -> L1A
                    copy(
                        copy_gm2l1_atom, l1_a_tensor,
                        gm_a_single_tensor.slice(
                            make_coord(i * base_m, k_iter * base_k), make_shape(cur_m, cur_step_k)));
                    // GM -> L1B
                    copy(
                        copy_gm2l1_atom, l1_b_tensor,
                        gm_b_single_tensor.slice(
                            make_coord(k_iter * base_k, j * base_n), make_shape(cur_step_k, cur_n)));
                    pipe_mte2_l1_index_mutex.unlock();
                    // Hold the L1 claim for MTE1 until all step_k slots of this group are consumed
                    // (released below when (k_iter + 1) % step_k == 0), so MTE2 can refill the group afterwards.
                    pipe_mte1_l1_index_mutex.lock();
                }
                // MTE1 stage: L1 -> L0, reading from the slot k_iter % step_k of the current buffer group.
                pipe_mte1_l0_index_mutex.lock();
                // L1A -> L0A
                copy(
                    copy_l12l0a_atom, l0_a_tensor,
                    l1_a_tensor.slice(make_coord(0, k_iter % step_k * base_k), make_shape(cur_m, cur_k)));
                // L1B -> L0B
                copy(
                    copy_l12l0b_atom, l0_b_tensor,
                    l1_b_tensor.slice(make_coord(k_iter % step_k * base_k, 0), make_shape(cur_k, cur_n)));
                if ((k_iter + 1) % step_k == 0 || k_iter + 1 == k_loop) {
                    // All slots of this L1 group are consumed: release it so MTE2 can prefetch the next group.
                    pipe_mte1_l1_index_mutex.unlock();
                }
                pipe_mte1_l0_index_mutex.unlock();
                // M stage: matrix compute on the L0A/L0B tiles, accumulating into L0C.
                pipe_m_l0_index_mutex.lock();

                // Mmad
                // L0C is locked for the whole K-accumulation of this output tile
                // (released after the last k iteration below).
                if (k_iter == 0) {
                    pipe_m_l0c_index_mutex.lock();
                }

                mmad_params para;
                para.m = cur_m;
                para.n = cur_n;
                para.k = cur_k;
                // First k iteration initializes L0C (C = A*B); later iterations accumulate (C += A*B).
                para.init_with_zero = (k_iter == 0) ? true : false;
                if constexpr (enable_unitflag) {
                    // unit_flag lets this mmad overlap with the previous Fixpipe copy-out on L0C.
                    para.unit_flag =
                        (k_iter == k_loop - 1) ? unit_flag_mode::enable_update : unit_flag_mode::enable_keep;
                }
                mmad(mmad_atom.with(para), l0_c_tensor, l0_a_tensor, l0_b_tensor);
                if (k_iter == k_loop - 1) {
                    // K-accumulation finished: release L0C for the Fixpipe copy-out below.
                    pipe_m_l0c_index_mutex.unlock();
                }

                pipe_m_l0_index_mutex.unlock();
            }
            // L0C -> GM: Fixpipe copies the result out, applying the per-channel quant scale
            // loaded from GM to L1 first.
            pipe_mte2_quant_index_mutex.lock();
            auto gm_c_slice = gm_c_single_tensor.slice(make_coord(i * base_m, j * base_n), make_shape(cur_m, cur_n));
            auto l1_quant_tensor = make_tensor(l1_quant_ptr, make_frame_layout<nd_ext_layout_ptn>(1, cur_n));
            copy(
                copy_gm2l1_atom, l1_quant_tensor,
                gm_quant_single_tensor.slice(make_coord(0, j * base_n), make_shape(1, cur_n)));
            pipe_mte2_quant_index_mutex.unlock();
            pipe_fix_quant_index_mutex.lock();

            pipe_fix_l0c_index_mutex.lock();
            if constexpr (enable_unitflag) {
                l0c_to_gm_params params;
                params.unit_flag = unit_flag_mode::enable_update;
                copy(copy_l0c2gm_atom.with(params), gm_c_slice, l0_c_tensor, l1_quant_tensor);
            } else {
                copy(copy_l0c2gm_atom, gm_c_slice, l0_c_tensor, l1_quant_tensor);
            }
            pipe_fix_l0c_index_mutex.unlock();
            pipe_fix_quant_index_mutex.unlock();
        }
    }

    sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    using a_type = int8_t;
    using b_type = int8_t;
    using l0c_type = int32_t;
    using c_type = half;

    int32_t m = 1024;
    int32_t n = 1024;
    int32_t k = 256;
    int32_t single_core_m = 256;
    int32_t single_core_n = 128;
    int32_t single_core_k = 256;

    constexpr int32_t base_m = 256;
    constexpr int32_t base_n = 256;
    constexpr int32_t base_k = 64;
    constexpr int32_t step_m = 1;
    constexpr int32_t step_n = 1;
    constexpr int32_t step_k = 4;

    constexpr bool enable_unitflag = true;
    constexpr uint32_t num_blocks = 32;

    size_t param1_file_size = m * k * sizeof(a_type);
    size_t param2_file_size = n * k * sizeof(b_type);
    size_t param3_file_size = m * n * sizeof(c_type);
    size_t param4_file_size = n * sizeof(uint64_t);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *x_host, *y_host, *z_host, *quantHost;
    a_type* x_device;
    b_type* y_device;
    c_type* z_device;
    uint64_t* quant_device;

    aclrtMallocHost((void**)(&x_host), param1_file_size);
    aclrtMallocHost((void**)(&y_host), param2_file_size);
    aclrtMallocHost((void**)(&z_host), param3_file_size);
    aclrtMallocHost((void**)(&quantHost), param4_file_size);
    aclrtMalloc((void**)&x_device, param1_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, param2_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&z_device, param3_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&quant_device, param4_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", param1_file_size, x_host, param1_file_size);
    ReadFile("./input/input_y.bin", param2_file_size, y_host, param2_file_size);
    ReadFile("./input/quant.bin", param4_file_size, quantHost, param4_file_size);

    aclrtMemcpy(x_device, param1_file_size, x_host, param1_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(y_device, param2_file_size, y_host, param2_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(quant_device, param4_file_size, quantHost, param4_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    mmad_quant_custom<a_type, b_type, l0c_type, c_type, base_m, base_n, base_k, step_m, step_n, step_k, enable_unitflag>
        <<<num_blocks, 0, stream>>>(
            x_device, y_device, z_device, quant_device, m, n, k, single_core_m, single_core_n, single_core_k);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(z_host, param3_file_size, z_device, param3_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", z_host, param3_file_size);

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFree(z_device);
    aclrtFree(quant_device);
    aclrtFreeHost(x_host);
    aclrtFreeHost(y_host);
    aclrtFreeHost(z_host);
    aclrtFreeHost(quantHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return 0;
}
