#include <cstdint>
#include <iostream>
#include <type_traits>
#include <vector>
#include "acl/acl.h"
#include "c_api/asc_simd.h"
#define CANN_ASC_USE_EXPERIMENTAL
#include "c_api/experimental/reg_arith_exp.h"

namespace {
constexpr uint32_t ELEMENT_COUNT = 64;
constexpr uint32_t SENTINEL = 0x5A5A5A5AU;
constexpr uint32_t BUFFER_WORDS = ELEMENT_COUNT * 4;
constexpr uint32_t BUFFER_BYTES = BUFFER_WORDS * sizeof(uint32_t);

enum class Operation { Add, AddCarry, Sub, SubCarry, Mull };

template <bool Signed, Operation Mode>
__simd_vf__ inline void pair_boundary_vf(
    __ubuf__ uint32_t* output, __ubuf__ uint32_t* input0, __ubuf__ uint32_t* input1, uint32_t active_count,
    uint32_t carry_value)
{
    using ScalarType = std::conditional_t<Signed, int32_t, uint32_t>;
    using VectorType = std::conditional_t<Signed, vector_int32_t, vector_uint32_t>;
    VectorType src0;
    VectorType src1;
    asc_loadalign(src0, reinterpret_cast<__ubuf__ ScalarType*>(input0));
    asc_loadalign(src1, reinterpret_cast<__ubuf__ ScalarType*>(input1));
    uint32_t carry_count = carry_value == 0 ? 0 : ELEMENT_COUNT;
    vector_bool carry_src = asc_update_mask_b32(carry_count);
    vector_bool mask = asc_update_mask_b32(active_count);
    if constexpr (Mode == Operation::Mull) {
        auto result = asc_mull(src0, src1, mask);
        asc_storealign(reinterpret_cast<__ubuf__ ScalarType*>(output), result.first, mask);
        asc_storealign(reinterpret_cast<__ubuf__ ScalarType*>(output + ELEMENT_COUNT), result.second, mask);
    } else {
        std::conditional_t<Signed, asc_int32_t_bool_pair, asc_uint32_t_bool_pair> result;
        if constexpr (Mode == Operation::Add) {
            result = asc_add_carry(src0, src1, mask);
        } else if constexpr (Mode == Operation::AddCarry) {
            result = asc_add_carry(src0, src1, carry_src, mask);
        } else if constexpr (Mode == Operation::Sub) {
            result = asc_sub_carry(src0, src1, mask);
        } else {
            result = asc_sub_carry(src0, src1, carry_src, mask);
        }
        asc_storealign(reinterpret_cast<__ubuf__ ScalarType*>(output), result.first, mask);
        asc_storealign(output + ELEMENT_COUNT, result.second);
    }
}

template <bool Signed, Operation Mode>
__global__ __vector__ void pair_boundary_kernel(__gm__ uint32_t* buffer, uint32_t active_count, uint32_t carry_value)
{
    asc_init();
    __ubuf__ uint32_t local[BUFFER_WORDS];
    asc_copy_gm2ub_align(local, buffer, BUFFER_BYTES);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_vf_call<pair_boundary_vf<Signed, Mode>>(
        local + ELEMENT_COUNT * 2, local, local + ELEMENT_COUNT, active_count, carry_value);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(buffer + ELEMENT_COUNT * 2, local + ELEMENT_COUNT * 2, BUFFER_BYTES / 2);
    asc_sync();
}

int64_t SignedValue(uint32_t bits)
{
    return (bits & 0x80000000U) != 0 ? static_cast<int64_t>(bits) - 0x100000000LL : bits;
}

template <bool Signed, Operation Mode>
bool RunBoundaryCase(uint32_t* device, uint32_t active_count, uint32_t carry_value)
{
    constexpr uint32_t inputs0[] = {0xFFFFFFFFU, 0U, 0x7FFFFFFFU, 0x80000000U, 0xFFFFFFFFU, 0U, 1U, 0x80000000U};
    constexpr uint32_t inputs1[] = {1U, 1U, 1U, 0xFFFFFFFFU, 0xFFFFFFFFU, 0U, 0xFFFFFFFFU, 0x80000000U};
    std::vector<uint32_t> buffer(BUFFER_WORDS, SENTINEL);
    for (uint32_t index = 0; index < ELEMENT_COUNT; ++index) {
        buffer[index] = inputs0[index % 8];
        buffer[ELEMENT_COUNT + index] = inputs1[index % 8];
    }
    if (aclrtMemcpy(device, BUFFER_BYTES, buffer.data(), BUFFER_BYTES, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        return false;
    }
    pair_boundary_kernel<Signed, Mode><<<1, 0>>>(device, active_count, carry_value);
    if (aclrtSynchronizeDevice() != ACL_SUCCESS ||
        aclrtMemcpy(buffer.data(), BUFFER_BYTES, device, BUFFER_BYTES, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        return false;
    }
    for (uint32_t index = 0; index < ELEMENT_COUNT; ++index) {
        uint32_t actual_first = buffer[ELEMENT_COUNT * 2 + index];
        uint32_t actual_second = buffer[ELEMENT_COUNT * 3 + index];
        if (index >= active_count) {
            if (actual_first != SENTINEL || (Mode == Operation::Mull && actual_second != SENTINEL)) {
                return false;
            }
            continue;
        }
        uint32_t left = buffer[index];
        uint32_t right = buffer[ELEMENT_COUNT + index];
        uint64_t expected;
        if constexpr (Mode == Operation::Mull) {
            if constexpr (Signed) {
                expected = static_cast<uint64_t>(SignedValue(left) * SignedValue(right));
            } else {
                expected = static_cast<uint64_t>(left) * right;
            }
        } else if constexpr (Mode == Operation::Sub || Mode == Operation::SubCarry) {
            uint32_t input_carry = Mode == Operation::Sub ? 1 : carry_value;
            expected = static_cast<uint64_t>(left) + static_cast<uint32_t>(~right) + input_carry;
        } else {
            uint32_t input_carry = Mode == Operation::Add ? 0 : carry_value;
            expected = static_cast<uint64_t>(left) + right + input_carry;
        }
        if constexpr (Mode != Operation::Mull) {
            uint32_t flags = buffer[ELEMENT_COUNT * 3 + index / 8];
            actual_second = (flags >> (4 * (index % 8))) & 1U;
        }
        if (actual_first != static_cast<uint32_t>(expected) || actual_second != static_cast<uint32_t>(expected >> 32)) {
            std::cerr << "Mismatch: signed=" << Signed << " operation=" << static_cast<int>(Mode)
                      << " active=" << active_count << " carry=" << carry_value << " lane=" << index << '\n';
            return false;
        }
    }
    return true;
}

template <bool Signed, Operation Mode>
bool RunBoundaryCases(uint32_t* device)
{
    constexpr uint32_t carry_cases = Mode == Operation::AddCarry || Mode == Operation::SubCarry ? 2 : 1;
    for (uint32_t active_count : {64U, 37U, 0U}) {
        for (uint32_t carry_value = 0; carry_value < carry_cases; ++carry_value) {
            if (!RunBoundaryCase<Signed, Mode>(device, active_count, carry_value)) {
                return false;
            }
        }
    }
    return true;
}

template <bool Signed>
bool RunAllOperations(uint32_t* device)
{
    return RunBoundaryCases<Signed, Operation::Add>(device) && RunBoundaryCases<Signed, Operation::AddCarry>(device) &&
           RunBoundaryCases<Signed, Operation::Sub>(device) && RunBoundaryCases<Signed, Operation::SubCarry>(device) &&
           RunBoundaryCases<Signed, Operation::Mull>(device);
}
} // namespace

int main()
{
    if (aclInit(nullptr) != ACL_SUCCESS) {
        return 1;
    }
    if (aclrtSetDevice(0) != ACL_SUCCESS) {
        aclFinalize();
        return 1;
    }
    uint32_t* device = nullptr;
    bool passed =
        aclrtMalloc(reinterpret_cast<void**>(&device), BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
    if (passed) {
        passed = RunAllOperations<false>(device) && RunAllOperations<true>(device);
    }
    if (device != nullptr) {
        aclrtFree(device);
    }
    aclrtResetDevice(0);
    aclFinalize();
    std::cout << (passed ? "[Success] 42 pair-return boundary cases passed." : "[Failed] Pair-return boundary cases.")
              << std::endl;
    return passed ? 0 : 1;
}
